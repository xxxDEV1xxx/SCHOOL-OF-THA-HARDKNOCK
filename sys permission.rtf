iptables -A FORWARD -i tun0 -o eth0 \
    -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

# VPN to LAN — VPN clients reach LAN
iptables -A FORWARD -i tun0 -o br-lan \
    -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

# LAN to VPN — LAN can reach VPN clients
iptables -A FORWARD -i br-lan -o tun0 \
    -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

# Block VPN clients from talking to each other
# unless you want client-to-client enabled
iptables -A FORWARD -i tun0 -o tun0 -j DROP

# ── NAT ───────────────────────────────────────────────────────
iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
iptables -t nat -A POSTROUTING -o eth0 \
    -s 10.8.0.0/24 -j MASQUERADE

# ── DNS INTERCEPTION — force all DNS through router ───────────
# Redirect any LAN DNS to router's DNS
iptables -t nat -A PREROUTING -i br-lan -p udp \
    --dport 53 \
    ! -d 192.168.1.1 \
    -j DNAT --to-destination 192.168.1.1:53

iptables -t nat -A PREROUTING -i br-lan -p tcp \
    --dport 53 \
    ! -d 192.168.1.1 \
    -j DNAT --to-destination 192.168.1.1:53

# Block DNS over HTTPS bypass attempts (DoH)
# These are common DoH IPs — Cloudflare, Google
iptables -A FORWARD -i br-lan -p tcp \
    -d 1.1.1.1 --dport 443 -j DROP
iptables -A FORWARD -i br-lan -p tcp \
    -d 1.0.0.1 --dport 443 -j DROP
iptables -A FORWARD -i br-lan -p tcp \
    -d 8.8.8.8 --dport 443 -j DROP
iptables -A FORWARD -i br-lan -p tcp \
    -d 8.8.4.4 --dport 443 -j DROP

# ── PORT SCAN DETECTION ───────────────────────────────────────
iptables -A INPUT -m recent --name PORTSCAN \
    --rcheck --seconds 86400 -j DROP
iptables -A FORWARD -m recent --name PORTSCAN \
    --rcheck --seconds 86400 -j DROP

# NULL scan
iptables -A INPUT -p tcp --tcp-flags ALL NONE \
    -m recent --name PORTSCAN --set -j DROP
# XMAS scan
iptables -A INPUT -p tcp \
    --tcp-flags ALL FIN,PSH,URG \
    -m recent --name PORTSCAN --set -j DROP
# SYN/RST scan
iptables -A INPUT -p tcp \
    --tcp-flags SYN,RST SYN,RST \
    -m recent --name PORTSCAN --set -j DROP
# FIN/SYN scan
iptables -A INPUT -p tcp \
    --tcp-flags SYN,FIN SYN,FIN \
    -m recent --name PORTSCAN --set -j DROP

# ── OUTPUT FROM ROUTER ────────────────────────────────────────
# DNS queries out
iptables -A OUTPUT -p udp --dport 53 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 53 -j ACCEPT
# NTP
iptables -A OUTPUT -p udp --dport 123 -j ACCEPT
# HTTP/HTTPS for opkg updates — restrict to WAN only
iptables -A OUTPUT -o eth0 -p tcp \
    --dport 80 -j ACCEPT
iptables -A OUTPUT -o eth0 -p tcp \
    --dport 443 -j ACCEPT
# VPN output
iptables -A OUTPUT -p udp --dport 1194 -j ACCEPT
# ICMP out
iptables -A OUTPUT -p icmp -j ACCEPT

# ── LOG AND DROP EVERYTHING ELSE ─────────────────────────────
iptables -A INPUT -m limit \
    --limit 5/min --limit-burst 10 \
    -j LOG --log-prefix "CTW_DROP_IN: " --log-level 4
iptables -A FORWARD -m limit \
    --limit 5/min --limit-burst 10 \
    -j LOG --log-prefix "CTW_DROP_FWD: " --log-level 4
iptables -A INPUT -j DROP
iptables -A FORWARD -j DROP

# ── IPv6 — DROP ALL unless you need it ───────────────────────
ip6tables -P INPUT DROP
ip6tables -P FORWARD DROP
ip6tables -P OUTPUT DROP
ip6tables -A INPUT -i lo -j ACCEPT
ip6tables -A OUTPUT -o lo -j ACCEPT
ip6tables -A INPUT -m state \
    --state ESTABLISHED,RELATED -j ACCEPT
ip6tables -A OUTPUT -m state \
    --state ESTABLISHED,RELATED -j ACCEPT

echo "CTW: iptables ruleset loaded" > /dev/kmsg
EOF

chmod 700 /etc/firewall.user

bash

# ── MAKE IT ALL PERSIST ───────────────────────────────────────

# OpenWRT calls /etc/firewall.user automatically
# after UCI firewall rules — already persistent

# Save iptables rules as backup
iptables-save > /etc/iptables.rules
ip6tables-save > /etc/ip6tables.rules

# Add restore to rc.local as fallback
cat >> /etc/rc.local << 'EOF'
iptables-restore < /etc/iptables.rules
ip6tables-restore < /etc/ip6tables.rules
EOF

# Start and enable OpenVPN
/etc/init.d/openvpn enable
/etc/init.d/openvpn start

# Restart firewall to apply all rules
/etc/init.d/firewall restart

bash

# ── VERIFY ────────────────────────────────────────────────────
iptables -L -v -n --line-numbers
iptables -t nat -L -v -n
iptables -t mangle -L -v -n
ip6tables -L -v -n
/etc/init.d/openvpn status

