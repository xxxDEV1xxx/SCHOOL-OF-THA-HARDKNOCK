Etc/rc.d/ returns S95done file that says Start=95 boot mount_root done and set leds to normal state. Lets harden and disable leds also this file or new
May 18

New file. Don't touch S95done — that's the boot sequencer.
bash

# Create CTW hardening init script
cat > /etc/init.d/ctw-harden << 'EOF'
#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

# Starts after S95done — filesystem and mounts are ready

start() {
    echo "CTW: hardening starting" > /dev/kmsg

    # ── PROC HARDENING ────────────────────────────────────────
    mount -o remount,hidepid=2 /proc 2>/dev/null

    # ── TMP HARDENING ─────────────────────────────────────────
    mount -o remount,noexec,nosuid,nodev /tmp 2>/dev/null

    # ── DEV HARDENING ─────────────────────────────────────────
    mount -o remount,nosuid,noexec /dev 2>/dev/null

    # ── KERNEL HARDENING VIA SYSCTL ───────────────────────────
    # No IP forwarding except what iptables explicitly allows
    echo 1 > /proc/sys/net/ipv4/ip_forward
    # Ignore ICMP broadcasts
    echo 1 > /proc/sys/net/ipv4/icmp_echo_ignore_broadcasts
    # Ignore bogus ICMP errors
    echo 1 > /proc/sys/net/ipv4/icmp_ignore_bogus_error_responses
    # SYN cookie protection
    echo 1 > /proc/sys/net/ipv4/tcp_syncookies
    # Reverse path filtering — drop spoofed packets
    echo 1 > /proc/sys/net/ipv4/conf/all/rp_filter
    echo 1 > /proc/sys/net/ipv4/conf/default/rp_filter
    # No source routing
    echo 0 > /proc/sys/net/ipv4/conf/all/accept_source_route
    echo 0 > /proc/sys/net/ipv4/conf/default/accept_source_route
    # No redirects
    echo 0 > /proc/sys/net/ipv4/conf/all/accept_redirects
    echo 0 > /proc/sys/net/ipv4/conf/default/accept_redirects
    echo 0 > /proc/sys/net/ipv4/conf/all/send_redirects
    echo 0 > /proc/sys/net/ipv4/conf/default/send_redirects
    # No log martians — noisy but useful for forensics
    echo 1 > /proc/sys/net/ipv4/conf/all/log_martians
    # Harden TCP timestamps — reduces fingerprinting
    echo 0 > /proc/sys/net/ipv4/tcp_timestamps
    # IPv6 — disable if not needed
    echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
    echo 1 > /proc/sys/net/ipv6/conf/default/disable_ipv6
    # Kernel pointer restriction
    echo 2 > /proc/sys/kernel/kptr_restrict 2>/dev/null
    # Dmesg restriction
    echo 1 > /proc/sys/kernel/dmesg_restrict 2>/dev/null
    # No core dumps
    echo 0 > /proc/sys/kernel/core_uses_pid 2>/dev/null
    echo "0 0 0 0" > /proc/sys/kernel/printk 2>/dev/null

    # ── DISABLE ALL LEDs ──────────────────────────────────────
    for led in /sys/class/leds/*/brightness; do
        echo 0 > "$led" 2>/dev/null
    done

    # Disable LED triggers
    for trigger in /sys/class/leds/*/trigger; do
        echo none > "$trigger" 2>/dev/null
    done

    echo "CTW: hardening complete" > /dev/kmsg
}

stop() {
    echo "CTW: hardening stop" > /dev/kmsg
}

restart() {
    start
}
EOF

chmod 755 /etc/init.d/ctw-harden

bash

# Enable it — creates symlink in /etc/rc.d/
/etc/init.d/ctw-harden enable

# Verify symlink created
ls -la /etc/rc.d/ | grep ctw
# Should show: S96ctw-harden and K10ctw-harden

# Run it now without rebooting
/etc/init.d/ctw-harden start

bash

# Verify LEDs actually went dark
cat /sys/class/leds/*/brightness
# All should return 0

# List all LED names on your specific AX89X
ls /sys/class/leds/
# AX89X typically has:
# phy0-2g::  phy1-5g::  phy2-5g::
# wan::  lan1-8::  power::  usb::  wps::
# All should now be 0

bash

# Verify sysctl hardening applied
cat /proc/sys/net/ipv4/tcp_syncookies
cat /proc/sys/net/ipv4/conf/all/rp_filter
cat /proc/sys/net/ipv4/conf/all/accept_redirects
cat /proc/sys/net/ipv6/conf/all/disable_ipv6
cat /proc/sys/kernel/kptr_restrict
# All should return expected hardened values

Why START=96:

S95done is the last standard OpenWRT boot step. START=96 guarantees all mounts, network interfaces, and overlay filesystem are fully initialized before the hardening runs. STOP=10 means it's one of the first things to run on shutdown — clears state early.

LED note for AX89X specifically:

The AX89X has a hardware LED button that can re-enable LEDs independently of software. If LEDs come back on after a button press add this to the script:
bash

# Disable LED button hardware trigger
# Find the button event and mask it
echo none > /sys/class/leds/*/trigger 2>/dev/null

# If using OpenWRT UCI LED config — disable all
uci show system | grep led | grep -oP 'system\.led[^.]+' | \
    sort -u | while read led; do
        uci set ${led}.dev=""
        uci set ${led}.trigger="none"
    done
uci commit system

