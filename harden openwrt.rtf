Two problems: the .nft files can't redeclare table inet fw4 because they're included inside it already, and you can't redeclare existing chains. Fix is to remove the table wrapper and use independent hook chains at higher priority so they run before fw4's chains:
sh

cat > /etc/nftables.d/99-ctw-harden.nft << 'EOF'
# CTW-11 SENTINEL - WAN Hardening Layer
# Inventor: Christopher Thomas Williams
# Chain of custody: loaded via fw4 include /etc/nftables.d/*.nft

    set bogons_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    chain ctw_input_harden {
        type filter hook input priority filter - 1; policy accept;
        iifname "wan" ct state invalid counter log prefix "CTW-DROP-INVALID: " drop
        iifname "wan" ip saddr @bogons_v4 counter log prefix "CTW-DROP-BOGON: " drop
        iifname "wan" meta nfproto ipv4 meta l4proto igmp counter log prefix "CTW-DROP-IGMP: " drop
        iifname "wan" ct state invalid counter log prefix "CTW-DROP-OUT-INVALID: " drop
    }

    chain ctw_forward_harden {
        type filter hook forward priority filter - 1; policy accept;
        iifname "wan" ct state invalid counter log prefix "CTW-DROP-FWD-INVALID: " drop
        iifname "wan" ip saddr @bogons_v4 counter log prefix "CTW-DROP-FWD-BOGON: " drop
    }
EOF

