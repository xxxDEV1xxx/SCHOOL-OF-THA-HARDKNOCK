Merged duplicate chains while preserving LAN SSH accessibility

Merged, deduplicated, and LAN SSH protected with explicit br-lan accept at the top of both chains before any drop logic touches it:
sh

cat > /etc/nftables.d/99-ctw-harden.nft << 'EOF'
# CTW-11 SENTINEL - WAN Hardening Layer
# Inventor: Christopher Thomas Williams
# Chain of custody: loaded via fw4 include /etc/nftables.d/*.nft

    set bogons_v4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    chain ctw_input_wan {
        type filter hook input priority filter - 10; policy accept;

        # LAN and loopback pass immediately - SSH on br-lan never touched
        iifname "br-lan" accept
        iifname "lo" accept

        # Allow established/related
        ct state established,related accept
        ct state invalid counter log prefix "CTW-DROP-INVALID: " drop

        # DHCP renew - must be explicit, conntrack does not reliably track UDP DHCP
        meta nfproto ipv4 udp dport 68 limit rate 4/minute counter accept
        meta nfproto ipv6 udp dport 546 limit rate 4/minute counter accept

        # Bogon/martian - RFC1918 + reserved arriving on WAN = spoofed
        iifname "wan" ip saddr @bogons_v4 counter log prefix "CTW-DROP-BOGON: " drop

        # TCP anomaly detection - stealth scan + malformed flag blocking
        tcp flags & (fin|syn) == (fin|syn) counter drop
        tcp flags & (syn|rst) == (syn|rst) counter drop
        tcp flags & (fin|rst) == (fin|rst) counter drop
        tcp flags & (fin|psh|urg) == (fin|psh|urg) counter drop
        tcp flags == 0x0 counter drop

        # SYN flood control
        iifname "wan" tcp flags syn limit rate 30/second burst 60 packets accept
        iifname "wan" tcp flags syn counter log prefix "CTW-DROP-SYN-FLOOD: " drop

        # DNS hardening - block external DNS to router on WAN
        iifname "wan" udp dport { 53, 853 } counter log prefix "CTW-DROP-DNS: " drop
        iifname "wan" tcp dport { 53, 853 } counter log prefix "CTW-DROP-DNS: " drop

        # IGMP block on WAN
        iifname "wan" meta l4proto igmp counter log prefix "CTW-DROP-IGMP: " drop

        # ICMP limiting - recon + amplification mitigation
        iifname "wan" ip protocol icmp limit rate 10/second accept
        iifname "wan" ip protocol icmp counter log prefix "CTW-DROP-ICMP: " drop

        # ICMPv6 limiting
        iifname "wan" ip6 nexthdr icmpv6 limit rate 50/second accept
        iifname "wan" ip6 nexthdr icmpv6 counter log prefix "CTW-DROP-ICMPv6: " drop

        # Drop all remaining unsolicited WAN -> router traffic
        iifname "wan" counter log prefix "CTW-DROP-WAN: " drop
    }

    chain ctw_forward_wan {
        type filter hook forward priority filter - 10; policy accept;

        # LAN-originated forwarding passes immediately
        iifname "br-lan" accept

        ct state established,related accept
        ct state invalid counter log prefix "CTW-DROP-FWD-INVALID: " drop

        # Bogon source blocking on WAN forward path
        iifname "wan" ip saddr @bogons_v4 counter log prefix "CTW-DROP-FWD-BOGON: " drop

        # Block all new unsolicited inbound WAN forwarding
        iifname "wan" ct state new counter log prefix "CTW-DROP-FWD-NEW: " drop
    }
EOF

fw4 check && fw4 reload

Key decisions made in the merge: the br-lan accept is line 1 in both chains so your SSH session survives unconditionally. DHCP renew gets explicit accepts before any drop logic since conntrack doesn't reliably classify UDP DHCP as established/related. Duplicate chain definitions collapsed into single authoritative chains. All drop events logged with CTW prefix for your evidence chain.

