Step 2 — Create the init script:
sh

cat > /opt/etc/init.d/S50suricata << 'EOF'
#!/bin/sh
# CTW-11 SENTINEL - Suricata IDS init script
# Inventor: Christopher Thomas Williams

SURICATA=/opt/bin/suricata
CONFIG=/opt/etc/suricata/suricata.yaml
LOGDIR=/opt/var/log/suricata
PIDFILE=/opt/var/run/suricata.pid

start() {
    echo "Starting Suricata IDS..."
    mkdir -p $LOGDIR
    $SURICATA -c $CONFIG --af-packet --pidfile $PIDFILE -D
    echo "Suricata started."
}

stop() {
    echo "Stopping Suricata IDS..."
    if [ -f $PIDFILE ]; then
        kill $(cat $PIDFILE)
        rm -f $PIDFILE
    fi
    echo "Suricata stopped."
}

status() {
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "Suricata is running (PID $(cat $PIDFILE))"
    else
        echo "Suricata is not running"
    fi
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 2; start ;;
    status)  status ;;
    *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
EOF

chmod +x /opt/etc/init.d/S50suricata

Step 3 — Test run before committing to autostart:
