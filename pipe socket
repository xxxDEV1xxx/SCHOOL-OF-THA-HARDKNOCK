/* --------------------------------------------------------
 * ctw_capture_mem
 * dd if=/dev/mem of=... for each known bzImage region
 * Uses read()/write() loop — no dd binary needed
 * -------------------------------------------------------- */
ctw_capture_mem:
    /* open /dev/mem */
    movl    $SYS_open, %eax
    movl    $str_devmem, %ebx
    movl    $O_RDONLY, %ecx
    int     $0x80
    testl   %eax, %eax
    js      .Lmem_fail
    movl    %eax, fd_mem

    /* Capture setup region 0x3000 */
    movl    $(BZIMG_SETUP_SKIP * 512), %eax
    movl    fd_mem, %ebx
    call    ctw_lseek
    movl    $str_bzimg_setup, %ebx
    movl    $(BZIMG_SETUP_COUNT * 512), %ecx
    call    ctw_dd_region

    /* Capture protected mode at 1MB */
    movl    $(BZIMG_PROT_SKIP * 512), %eax
    movl    fd_mem, %ebx
    call    ctw_lseek
    movl    $str_bzimg_prot, %ebx
    movl    $(BZIMG_PROT_COUNT * 512), %ecx
    call    ctw_dd_region

    /* Capture initrd at 0x27c5c000 */
    movl    $BZIMG_INITRD_ADDR, %eax
    movl    fd_mem, %ebx
    call    ctw_lseek
    movl    $str_bzimg_initrd, %ebx
    movl    $BZIMG_INITRD_SIZE, %ecx
    call    ctw_dd_region

.Lmem_fail:
    ret

/* --------------------------------------------------------
 * ctw_dd_region
 * ebx = output path string
 * ecx = byte count
 * fd_mem must be seeked to correct offset
 * -------------------------------------------------------- */
ctw_dd_region:
    pushl   %ecx
    pushl   %ebx

    /* open output file */
    movl    $SYS_open, %eax
    popl    %ebx
    movl    $(O_WRONLY|O_CREAT|O_TRUNC), %ecx
    movl    $0600, %edx
    int     $0x80
    movl    %eax, fd_dst

    popl    %ecx            /* byte count */
    movl    %ecx, bytes_remaining

.Ldd_loop:
    movl    bytes_remaining, %ecx
    testl   %ecx, %ecx
    jz      .Ldd_done
    cmpl    $4096, %ecx
    jle     .Ldd_small
    movl    $4096, %ecx

.Ldd_small:
    /* read from /dev/mem */
    movl    $SYS_read, %eax
    movl    fd_mem, %ebx
    movl    $iobuf, %ecx
    int     $0x80
    testl   %eax, %eax
    jle     .Ldd_done

    /* write to output */
    movl    %eax, %ecx
    movl    $SYS_write, %eax
    movl    fd_dst, %ebx
    movl    $iobuf, %ecx
    int     $0x80

    subl    %eax, bytes_remaining
    jmp     .Ldd_loop

.Ldd_done:
    movl    $SYS_close, %eax
    movl    fd_dst, %ebx
    int     $0x80
    ret

/* --------------------------------------------------------
 * ctw_kill_userprocs
 * Walk /proc numerically, kill everything with a cmdline
 * that isn't us
 * -------------------------------------------------------- */
ctw_kill_userprocs:
    movl    $2, pid_cursor          /* start at PID 2 */
.Lkill_loop:
    movl    pid_cursor, %eax
    cmpl    $32768, %eax
    jg      .Lkill_done
    call    ctw_check_and_kill
    incl    pid_cursor
    jmp     .Lkill_loop
.Lkill_done:
    ret

/* --------------------------------------------------------
 * ctw_unload_modules
 * rmmod via delete_module syscall (#129)
 * Skips ext2 and loop
 * -------------------------------------------------------- */
ctw_unload_modules:
    /* Real implementation iterates /proc/modules
     * Inline here for brevity — full version reads
     * /proc/modules line by line
     */
    movl    $129, %eax          /* sys_delete_module */
    movl    $str_mod_usb, %ebx
    xorl    %ecx, %ecx
    int     $0x80

    movl    $129, %eax
    movl    $str_mod_firewire, %ebx
    xorl    %ecx, %ecx
    int     $0x80
    ret

/* --------------------------------------------------------
 * ctw_launch_qemu
 * execve() qemu-system-i386 with your exact args
 * -------------------------------------------------------- */
ctw_launch_qemu:
    movl    $SYS_execve, %eax
    movl    $str_qemu_bin, %ebx
    movl    $qemu_argv, %ecx
    movl    $qemu_envp, %edx
    int     $0x80
    ret

/* --------------------------------------------------------
 * ctw_pipe_copy — generic fd_src → fd_dst copy
 * -------------------------------------------------------- */
ctw_pipe_copy:
.Lpipe_loop:
    movl    $SYS_read, %eax
    movl    fd_src, %ebx
    movl    $iobuf, %ecx
    movl    $4096, %edx
    int     $0x80
    testl   %eax, %eax
    jle     .Lpipe_done
    movl    %eax, %edx
    movl    $SYS_write, %eax
    movl    fd_dst, %ebx
    movl    $iobuf, %ecx
    int     $0x80
    jmp     .Lpipe_loop
.Lpipe_done:
    ret

ctw_lseek:
    /* eax=offset, ebx=fd */
    pushl   %eax
    movl    $19, %eax           /* sys_lseek */
    popl    %ecx                /* offset */
    xorl    %edx, %edx          /* SEEK_SET */
    int     $0x80
    ret

