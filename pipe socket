#!/bin/bash
# CTW Stage0 Flat Binary Builder
# Produces raw binary — no ELF, no headers
# Inventor: Christopher Thomas Williams

set -e

SRC=/boot/ctw-stage0.S
OBJ=/tmp/ctw-stage0.o
BIN=/boot/ctw-stage0.bin
MAP=/root/ctw-forensic/stage0.map

# Step 1: Preprocess + Assemble
# GAS runs cpp first because .S extension
# -m32 for i386 target matching your Fedora 9 kernel
as --32 -o $OBJ $SRC

# Step 2: Link to flat binary at load address
# -Ttext sets origin — LILO loads here
# --oformat binary strips ALL ELF structure
# -Map produces symbol map for forensic reference
ld -m elf_i386 \
   -Ttext 0x10000 \
   --oformat binary \
   -Map $MAP \
   -o $BIN \
   $OBJ

# Step 3: Verify — must have NO ELF magic
hexdump -C $BIN | head -2
echo "First 4 bytes must NOT be 7f 45 4c 46 (ELF)"

# Step 4: Hash and lock
sha256sum $BIN > /root/ctw-forensic/stage0.sha256
chattr +i $BIN
chmod 400 $BIN

echo "Built: $BIN"
ls -lh $BIN

