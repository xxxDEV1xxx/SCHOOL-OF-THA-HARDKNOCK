Good — I have the full protocol picture now. Here's a complete rundown for pulling data from the stock (unmodified firmware) FS-5000 on Windows 10.
FS-5000 Stock Firmware — Direct Data Pull on Win10
1. USB Driver

For USB data connections on Windows, install the CH340 driver. The FS-5000 presents as a CH340 USB-to-serial bridge (VID 0x1A86, PID 0x7523). Without this driver Win10 won't enumerate a COM port.
GitHub

    Download: https://www.wch-ic.com/downloads/CH341SER_EXE.html
    After install, plug in the device and confirm a COMx port appears in Device Manager → Ports.

2. Protocol (Stock Firmware)

It's not a dumb protocol — you need to initiate the transfer. The device operates at 115200 baud.
GitHub

Packet framing:

AA <len> <payload...> <checksum> 55

    Header: 0xAA
    Length byte: len(payload) + 3
    Checksum: sum(AA + len + payload) % 256
    Trailer: 0x55

Key command bytes (reverse-engineered by the community):

0x06  → get_version
0x07  → get_dose
0x0E  → read (live streaming)
0x0F  → read_rate_curve
0x03  → read_dose_curve
0x10  → read_alarms

Live data format once streaming starts:

2025-01-18T22:33:26;DR:0.23uSv/h;D:3.70uSv;CPS:0001;CPM:000029;AVG:0.16uSv/h;DT:0000000;S:0.00uSv;W:0

3. Python Script (Windows-compatible)

Install deps first:
cmd

pip install pyserial

Minimal working script for Win10 — auto-detects the CH340 port and streams live readings:
python

#!/usr/bin/env python3
"""
FS-5000 stock firmware live data pull — Windows 10
Protocol reverse-engineered by Tim Brooks (brookst@github)
"""

import serial
import serial.tools.list_ports
import struct
import logging
import datetime

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")
log = logging.getLogger("FS5000")

VID_PID = (0x1A86, 0x7523)  # CH340

COMMAND = {
    "get_version":     b"\x06",
    "get_dose":        b"\x07",
    "read":            b"\x0e",
    "read_rate_curve": b"\x0f",
    "read_alarms":     b"\x10",
}

def find_port():
    for p in serial.tools.list_ports.comports():
        if p.vid == VID_PID[0] and p.pid == VID_PID[1]:
            log.info(f"Found FS-5000 on {p.device}")
            return p.device
    raise RuntimeError("FS-5000 not found. Is the CH340 driver installed?")

def checksum(data: bytes) -> bytes:
    return bytes([sum(data) % 256])

def make_packet(payload: bytes) -> bytes:
    data = b"\xaa"
    data += bytes([len(payload) + 3])
    data += payload
    data += checksum(data)
    data += b"\x55"
    return data

def recv_packet(port):
    header = port.read(2)
    if not header or header[0] != 0xAA:
        return None
    length = header[1]
    data = port.read(length - 1)
    if not data or data[-1] != 0x55:
        return None
    calc = checksum(header + data[:-2])[0]
    if calc != data[-2]:
        log.warning(f"Checksum mismatch: got {data[-2]:02x}, expected {calc:02x}")
        return None
    return data[:-2]  # strip checksum+trailer

def main():
    com = find_port()
    with serial.Serial(com, 115200, timeout=2) as port:
        # Start live read stream
        port.write(make_packet(COMMAND["read"]))
        log.info("Streaming live data (Ctrl+C to stop)...")
        try:
            while True:
                pkt = recv_packet(port)
                if pkt is None:
                    continue
                # Live data packets contain ASCII payload after command byte
                payload = pkt[1:]
                try:
                    decoded = payload.decode("ascii", errors="replace").strip()
                    if decoded:
                        print(decoded)
                except Exception as e:
                    log.debug(f"Non-ASCII packet: {pkt.hex()}")
        except KeyboardInterrupt:
            log.info("Stopped.")

if __name__ == "__main__":
    main()

