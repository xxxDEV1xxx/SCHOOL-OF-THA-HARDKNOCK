# Replace the "read" command block with:
port.write(make_packet(COMMAND["read_rate_curve"]))
# First response is a success + packet count
pkt = recv_packet(port)
# pkt[2:] contains packet count as 2-byte big-endian
if pkt:
    num_packets = struct.unpack("!H", pkt[2:4])[0]
    log.info(f"Expecting {num_packets} log packets")
    all_data = b""
    for i in range(num_packets):
        p = recv_packet(port)
        if p:
            all_data += p[2:]  # skip cmd+seq bytes
    # all_data now contains raw log — parse per your needs
    print(all_data.hex())

