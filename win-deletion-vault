### 3.7 SHA-256 in Kernel Mode

WDK does not export a public SHA-256 API directly; use `BCryptHashData` via the kernel-accessible `Ksecdd.sys` provider:

```c
#include <bcrypt.h>
#pragma comment(lib, "Ksecdd.lib")   // kernel-mode CNG

NTSTATUS DvHashFile(
    _In_  PFLT_INSTANCE Instance,
    _In_  PFILE_OBJECT  FileObject,
    _Out_ PUCHAR        Sha256Out)   // 32 bytes
{
    NTSTATUS          status;
    BCRYPT_ALG_HANDLE hAlg  = NULL;
    BCRYPT_HASH_HANDLE hHash = NULL;
    PUCHAR            hashObj = NULL;
    ULONG             hashObjLen, resultLen;
    LARGE_INTEGER     offset = {0};
    PVOID             chunk  = NULL;

    status = BCryptOpenAlgorithmProvider(&hAlg,
        BCRYPT_SHA256_ALGORITHM, NULL, 0);
    if (!NT_SUCCESS(status)) return status;

    BCryptGetProperty(hAlg, BCRYPT_OBJECT_LENGTH,
        (PUCHAR)&hashObjLen, sizeof(ULONG), &resultLen, 0);

    hashObj = ExAllocatePool2(POOL_FLAG_NON_PAGED, hashObjLen, 'VHsh');
    chunk   = ExAllocatePool2(POOL_FLAG_NON_PAGED, DVAULT_COPY_CHUNK, 'VChk');

    if (!hashObj || !chunk) {
        status = STATUS_INSUFFICIENT_RESOURCES; goto done;
    }

    BCryptCreateHash(hAlg, &hHash, hashObj, hashObjLen, NULL, 0, 0);

    // Read and hash file in chunks
    for (;;) {
        IO_STATUS_BLOCK iosb;
        status = FltReadFile(Instance, FileObject, &offset,
            DVAULT_COPY_CHUNK, chunk, FLTFL_IO_OPERATION_NON_CACHED,
            NULL, &iosb, NULL);

        if (!NT_SUCCESS(status)) break;
        if (iosb.Information == 0) break;

        BCryptHashData(hHash, chunk, (ULONG)iosb.Information, 0);
        offset.QuadPart += iosb.Information;
    }

    if (status == STATUS_END_OF_FILE) status = STATUS_SUCCESS;
    if (NT_SUCCESS(status))
        BCryptFinishHash(hHash, Sha256Out, 32, 0);

done:
    if (hHash) BCryptDestroyHash(hHash);
    if (hAlg)  BCryptCloseAlgorithmProvider(hAlg, 0);
    if (hashObj) ExFreePoolWithTag(hashObj, 'VHsh');
    if (chunk)   ExFreePoolWithTag(chunk,   'VChk');
    return status;
}
```

