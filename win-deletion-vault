### 3.3 File Capture Engine

```c
// dvault_capture.c

#define DVAULT_COPY_CHUNK  (256 * 1024)  // 256 KB chunks

NTSTATUS DvCaptureFile(
    _In_ PFLT_CALLBACK_DATA    Data,
    _In_ PCFLT_RELATED_OBJECTS FltObjects)
{
    NTSTATUS         status;
    PFLT_FILE_NAME_INFORMATION nameInfo = NULL;
    WCHAR            vaultPath[MAX_PATH];
    LARGE_INTEGER    fileSize;
    DVAULT_METADATA  meta = {0};

    /* ── Get full source path ────────────────────────────────── */
    status = FltGetFileNameInformation(Data,
        FLT_FILE_NAME_NORMALIZED | FLT_FILE_NAME_QUERY_DEFAULT,
        &nameInfo);
    if (!NT_SUCCESS(status)) return status;

    FltParseFileNameInformation(nameInfo);

    /* ── Query file size ─────────────────────────────────────── */
    status = DvQueryFileSize(FltObjects->Instance,
                             FltObjects->FileObject, &fileSize);
    if (!NT_SUCCESS(status)) goto cleanup;

    /* ── Build vault destination path ───────────────────────── */
    status = DvBuildVaultPath(nameInfo, vaultPath, sizeof(vaultPath));
    if (!NT_SUCCESS(status)) goto cleanup;

    /* ── SHA-256 hash the source file ───────────────────────── */
    status = DvHashFile(FltObjects->Instance,
                        FltObjects->FileObject,
                        meta.Sha256);
    if (!NT_SUCCESS(status)) goto cleanup;

    /* ── Copy file data to vault ─────────────────────────────── */
    status = DvCopyFileData(FltObjects->Instance,
                            FltObjects->FileObject,
                            vaultPath, fileSize);
    if (!NT_SUCCESS(status)) goto cleanup;

    /* ── Populate metadata ───────────────────────────────────── */
    KeQuerySystemTime(&meta.CaptureTime);
    meta.OriginalSize = fileSize.QuadPart;
    meta.ProcessId    = (ULONG)(ULONG_PTR)
                        PsGetCurrentProcessId();
    DvGetProcessName(meta.ProcessName, sizeof(meta.ProcessName));
    RtlCopyMemory(&meta.OriginalPath,
                  nameInfo->Name.Buffer,
                  min(nameInfo->Name.Length,
                      sizeof(meta.OriginalPath) - sizeof(WCHAR)));

    /* ── Send metadata to user-mode service ──────────────────── */
    status = DvSendToService(&meta);

cleanup:
    if (nameInfo) FltReleaseFileNameInformation(nameInfo);
    return status;
}
```

