### 3.4 Vault Path Generator (Kernel)

```c
// dvault_path.c

NTSTATUS DvBuildVaultPath(
    _In_  PFLT_FILE_NAME_INFORMATION NameInfo,
    _Out_ PWCHAR                     VaultPath,
    _In_  SIZE_T                     VaultPathBytes)
{
    // Format: \??\C:\Vault\YYYY-MM-DD\{VolumeGuid}\<UUID>.bin
    // UUID derived from original path hash to avoid collisions

    TIME_FIELDS   tf;
    LARGE_INTEGER now;
    UCHAR         pathHash[32];
    WCHAR         guidStr[40];

    KeQuerySystemTime(&now);
    RtlTimeToTimeFields(&now, &tf);

    /* Volume GUID from NameInfo->Volume */
    DvFormatVolumeGuid(&NameInfo->Volume, guidStr, sizeof(guidStr));

    /* Short hash of original path for filename uniqueness */
    DvSha256Buffer(NameInfo->Name.Buffer,
                   NameInfo->Name.Length, pathHash);

    return RtlStringCchPrintfW(VaultPath,
        VaultPathBytes / sizeof(WCHAR),
        L"\\??\\C:\\Vault\\%04d-%02d-%02d\\%s\\%02X%02X%02X%02X%02X%02X%02X%02X.bin",
        tf.Year, tf.Month, tf.Day,
        guidStr,
        pathHash[0], pathHash[1], pathHash[2], pathHash[3],
        pathHash[4], pathHash[5], pathHash[6], pathHash[7]);
}
```

