### 3.6 Self-Protection: Vault Path Guard

```c
// dvault_protect.c

UNICODE_STRING g_VaultRootNt;  // L"\\Device\\HarddiskVolumeX\\Vault"

BOOLEAN DvIsVaultPath(_In_ PFILE_OBJECT FileObject)
{
    if (!FileObject || !FileObject->FileName.Buffer) return FALSE;

    // Build full device path and compare prefix
    // Prevents recursive capture of vault writes
    return RtlPrefixUnicodeString(&g_VaultRootNt,
                                  &FileObject->FileName,
                                  TRUE);  // case insensitive
}
