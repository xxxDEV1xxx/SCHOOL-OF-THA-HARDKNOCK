## 5. User-Mode Service Design

### 5.1 Service Skeleton (C++)

```cpp
// dvaultd.cpp — main service

#include <windows.h>
#include <fltuser.h>
#include <thread>
#include "vault_indexer.h"
#include "crypto_engine.h"
#include "web_ui.h"

#pragma comment(lib, "fltlib.lib")

class DeletionVaultService {
    HANDLE        m_Port = INVALID_HANDLE_VALUE;
    VaultIndexer  m_Indexer;
    CryptoEngine  m_Crypto;
    WebUI         m_WebUI;
    std::thread   m_ListenThread;
    volatile bool m_Running = false;

public:
    bool Start() {
        // Connect to kernel port
        HRESULT hr = FilterConnectCommunicationPort(
            L"\\DVaultPort", 0, nullptr, 0, nullptr, &m_Port);
        if (FAILED(hr)) return false;

        m_Indexer.Open(L"C:\\Vault\\vault.db");
        m_Crypto.LoadKey();              // from TPM or protected keystore
        m_WebUI.Start(7743);             // management UI

        m_Running = true;
        m_ListenThread = std::thread(&DeletionVaultService::ListenLoop, this);
        return true;
    }

    void ListenLoop() {
        alignas(8) BYTE buf[sizeof(FILTER_MESSAGE_HEADER)
                            + sizeof(DVAULT_CAPTURE_MSG)];
        FILTER_MESSAGE_HEADER* header = (FILTER_MESSAGE_HEADER*)buf;
        DVAULT_CAPTURE_MSG*    msg    =
            (DVAULT_CAPTURE_MSG*)(buf + sizeof(FILTER_MESSAGE_HEADER));

        while (m_Running) {
            HRESULT hr = FilterGetMessage(m_Port, header,
                sizeof(buf), nullptr);
            if (FAILED(hr)) continue;

            if (msg->Header.Magic != DVAULT_MSG_MAGIC) continue;

            switch (msg->Header.Type) {
            case DVAULT_MSG_CAPTURE:
                HandleCapture(header, msg);
                break;
            }
        }
    }

    void HandleCapture(FILTER_MESSAGE_HEADER* hdr,
                       DVAULT_CAPTURE_MSG*    msg)
    {
        /* 1. Encrypt the vault file in-place */
        m_Crypto.EncryptFile(msg->VaultPath);

        /* 2. Write metadata JSON */
        WriteMetadataJson(msg);

        /* 3. Index in SQLite */
        m_Indexer.Insert({
            .sha256       = HexEncode(msg->Sha256, 32),
            .originalPath = msg->OriginalPath,
            .vaultPath    = msg->VaultPath,
            .processId    = msg->ProcessId,
            .processName  = msg->ProcessName,
            .captureTime  = FiletimeToIso8601(msg->CaptureTime),
            .fileSize     = msg->OriginalSize
        });

        /* 4. Reply to kernel (always allow for now) */
        DVAULT_AUTH_REPLY reply{};
        reply.Header.Magic   = DVAULT_MSG_MAGIC;
        reply.Header.Type    = DVAULT_MSG_AUTHREPLY;
        reply.Allowed        = TRUE;

        FilterReplyMessage(m_Port,
            (FILTER_REPLY_HEADER*)&reply, sizeof(reply));
    }
};
```

