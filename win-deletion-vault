## 9. Security Hardening

### 9.1 Driver Self-Protection

```c
// Prevent userland from disabling the minifilter

NTSTATUS DvInstanceQueryTeardown(
    _In_ PCFLT_RELATED_OBJECTS FltObjects,
    _In_ FLT_INSTANCE_QUERY_TEARDOWN_FLAGS Flags)
{
    UNREFERENCED_PARAMETER(FltObjects);
    UNREFERENCED_PARAMETER(Flags);

    // Return failure to reject voluntary detach
    // (Detach still possible via FltDetachVolume from kernel)
    return STATUS_FLT_DO_NOT_DETACH;
}
```

### 9.2 Vault Directory ACL

```powershell
# Restrict vault to SYSTEM only at filesystem level
# Combined with minifilter self-protection for defense-in-depth

$path = "C:\Vault"
$acl = New-Object System.Security.AccessControl.DirectorySecurity
$acl.SetAccessRuleProtection($true, $false)  # disable inheritance

$rule = New-Object System.Security.AccessControl.FileSystemAccessRule(
    "NT AUTHORITY\SYSTEM", "FullControl", 
    "ContainerInherit,ObjectInherit", "None", "Allow")
$acl.AddAccessRule($rule)

Set-Acl -Path $path -AclObject $acl
```

### 9.3 Communication Port Security

```c
// Only allow SYSTEM and Administrators to connect to the filter port

PSECURITY_DESCRIPTOR DvBuildPortSd()
{
    // Grant FILE_ALL_ACCESS only to Local System (S-1-5-18)
    // and Builtin Administrators (S-1-5-32-544)
    // SDDL: D:(A;;FA;;;SY)(A;;FA;;;BA)
    PSECURITY_DESCRIPTOR sd;
    ConvertStringSecurityDescriptorToSecurityDescriptorW(
        L"D:(A;;FA;;;SY)(A;;FA;;;BA)",
        SDDL_REVISION_1, &sd, NULL);
    return sd;
}
```

