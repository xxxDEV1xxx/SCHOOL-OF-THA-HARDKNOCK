## 4. Kernel / User-Mode Communication

### 4.1 Message Protocol

Both directions use a fixed-size header + variable payload:

```c
// dvault_ipc.h  — shared between kernel and user-mode

#define DVAULT_MSG_MAGIC      0x44564C54UL  // 'DVLT'
#define DVAULT_MSG_CAPTURE    0x01
#define DVAULT_MSG_QUERYAUTH  0x02
#define DVAULT_MSG_AUTHREPLY  0x82
#define MAX_PATH_WCHARS       512

#pragma pack(push, 1)

typedef struct _DVAULT_MSG_HEADER {
    ULONG   Magic;          // DVAULT_MSG_MAGIC
    ULONG   Type;           // DVAULT_MSG_*
    ULONG   PayloadLength;
} DVAULT_MSG_HEADER;

typedef struct _DVAULT_CAPTURE_MSG {
    DVAULT_MSG_HEADER Header;
    UCHAR             Sha256[32];
    LONGLONG          OriginalSize;
    ULONG             ProcessId;
    WCHAR             ProcessName[16];
    WCHAR             OriginalPath[MAX_PATH_WCHARS];
    WCHAR             VaultPath[MAX_PATH_WCHARS];
    LARGE_INTEGER     CaptureTime;   // FILETIME in kernel LARGE_INTEGER form
} DVAULT_CAPTURE_MSG;

typedef struct _DVAULT_AUTH_REPLY {
    DVAULT_MSG_HEADER Header;
    BOOLEAN           Allowed;
    WCHAR             Reason[128];
} DVAULT_AUTH_REPLY;

#pragma pack(pop)
```

### 4.2 Kernel Send Side

```c
NTSTATUS DvSendToService(_In_ PDVAULT_METADATA Meta)
{
    DVAULT_CAPTURE_MSG  msg  = {0};
    DVAULT_AUTH_REPLY   reply = {0};
    ULONG               replyLen = sizeof(reply);
    NTSTATUS            status;

    if (!g_ClientPort) return STATUS_PORT_DISCONNECTED;

    msg.Header.Magic         = DVAULT_MSG_MAGIC;
    msg.Header.Type          = DVAULT_MSG_CAPTURE;
    msg.Header.PayloadLength = sizeof(msg) - sizeof(DVAULT_MSG_HEADER);
    msg.OriginalSize         = Meta->OriginalSize;
    msg.ProcessId            = Meta->ProcessId;
    msg.CaptureTime          = Meta->CaptureTime;

    RtlCopyMemory(msg.Sha256,       Meta->Sha256,       32);
    RtlCopyMemory(msg.ProcessName,  Meta->ProcessName,  sizeof(msg.ProcessName));
    RtlCopyMemory(msg.OriginalPath, Meta->OriginalPath, sizeof(msg.OriginalPath));
    RtlCopyMemory(msg.VaultPath,    Meta->VaultPath,    sizeof(msg.VaultPath));

    status = FltSendMessage(g_FilterHandle, &g_ClientPort,
        &msg, sizeof(msg), &reply, &replyLen, NULL);

    return NT_SUCCESS(status) ? (reply.Allowed ? STATUS_SUCCESS
                                               : STATUS_ACCESS_DENIED)
                              : status;
}
```

