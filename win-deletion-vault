### 3.2 Pre-Operation Delete Interception

```c
// dvault_pre.c

FLT_PREOP_CALLBACK_STATUS
DvPreSetInformation(
    _Inout_ PFLT_CALLBACK_DATA    Data,
    _In_    PCFLT_RELATED_OBJECTS FltObjects,
    _Out_   PVOID                *CompletionContext)
{
    PFILE_DISPOSITION_INFORMATION     dispInfo;
    PFILE_DISPOSITION_INFORMATION_EX  dispInfoEx;
    BOOLEAN deleteRequested = FALSE;

    UNREFERENCED_PARAMETER(CompletionContext);

    /* ── Detect delete intent ───────────────────────────────── */
    switch (Data->Iopb->Parameters.SetFileInformation.FileInformationClass)
    {
    case FileDispositionInformation:
        dispInfo = (PFILE_DISPOSITION_INFORMATION)
            Data->Iopb->Parameters.SetFileInformation.InfoBuffer;
        deleteRequested = dispInfo->DeleteFile;
        break;

    case FileDispositionInformationEx:
        dispInfoEx = (PFILE_DISPOSITION_INFORMATION_EX)
            Data->Iopb->Parameters.SetFileInformation.InfoBuffer;
        deleteRequested =
            (dispInfoEx->Flags & FILE_DISPOSITION_DELETE) != 0;
        break;

    default:
        return FLT_PREOP_SUCCESS_NO_CALLBACK;
    }

    if (!deleteRequested)
        return FLT_PREOP_SUCCESS_NO_CALLBACK;

    /* ── Is this a vault-internal file? skip recursion ─────── */
    if (DvIsVaultPath(FltObjects->FileObject))
        return FLT_PREOP_SUCCESS_NO_CALLBACK;

    /* ── Copy file to vault before allowing delete ──────────── */
    NTSTATUS copyStatus = DvCaptureFile(Data, FltObjects);

    if (!NT_SUCCESS(copyStatus)) {
        /* POLICY DECISION:
         * Option A (forensic-strict): block the delete, log failure
         * Option B (permissive): allow delete anyway, log capture fail  */
        KdPrint(("DVault: capture FAILED 0x%08X — blocking delete\n", copyStatus));
        Data->IoStatus.Status      = STATUS_ACCESS_DENIED;
        Data->IoStatus.Information = 0;
        return FLT_PREOP_COMPLETE;   // block
    }

    /* Capture succeeded — let original IRP proceed */
    return FLT_PREOP_SUCCESS_NO_CALLBACK;
}
```

