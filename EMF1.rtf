ls -la /boot/.initramfs*

Step 8 — Exit and cleanup
bash

exit

umount /mnt/dev
umount /mnt/proc
umount /mnt/sys
umount /mnt/run
umount /mnt/boot
umount /mnt

vgchange -an rl
cryptsetup luksClose rl2

