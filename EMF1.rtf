#include <util/delay.h>

// Sweep 0.1Hz to 100Hz continuously
// Output on PB0 through isolation transformer

float freq = 0.1;
float step = 0.01;
bool ascending = true;

void set_frequency(float hz) {
    uint16_t half_period_ms = (uint16_t)(500.0 / hz);
    PORTB |= (1 << PB0);
    _delay_ms(half_period_ms);
