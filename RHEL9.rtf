            CHILDREN=$(pgrep -P $PID 2>/dev/null)
            for CHILD in $CHILDREN; do
                if ! grep -q "^$CHILD$" \
                  $PIDDIR/tracked_children.txt 2>/dev/null; then
                    echo $CHILD >> $PIDDIR/tracked_children.txt
                    log "${BOLD}${RED}[PID:$PID] SPAWNED CHILD: \
$CHILD$(cat /proc/$CHILD/cmdline 2>/dev/null | \
tr '\0' ' ')${RESET}"
                    track_pid $CHILD "child_of_$PID"
                fi
            done
            sleep 0.2
        done
        log "${YELLOW}[PID:$PID] Process exited${RESET}"
    ) &
}

# ---- FUNCTION: Network tracker ----
track_network() {
    log "${BOLD}${BLUE}=== NETWORK TRACKER STARTED ===${RESET}"

    # Capture all traffic
    tcpdump -i any \
        -w $OUTDIR/all_traffic_$(date +%s).pcap \
        -s 65535 &
    log "${BLUE}tcpdump PID: $!${RESET}"

    # Live connection monitor
    (
        while true; do
            SS=$(ss -tupanoe 2>/dev/null | \
              grep -v "127.0.0.1\|::1")
            if [ -n "$SS" ]; then
                PREV=$(cat $OUTDIR/prev_connections.txt \
                  2>/dev/null)
                if [ "$SS" != "$PREV" ]; then
                    log "${BOLD}${RED}NEW CONNECTIONS:${RESET}"
                    echo "$SS" | while read line; do
                        if ! echo "$PREV" | grep -qF "$line"; then
                            log "${RED}  NEW: $line${RESET}"
                            # Extract PID and track it
                            PID=$(echo "$line" | \
                              grep -oP 'pid=\K[0-9]+')
                            if [ -n "$PID" ]; then
                                track_pid $PID \
                                  "new_network_connection"
                            fi
                        fi
                    done
                    echo "$SS" > $OUTDIR/prev_connections.txt
                fi
            fi
            sleep 0.5
        done
    ) &
}

# ---- FUNCTION: D-Bus monitor ----
track_dbus() {
    log "${BOLD}${MAGENTA}=== DBUS TRACKER STARTED ===${RESET}"

    # Monitor system bus
    dbus-monitor --system 2>/dev/null | \
      tee $OUTDIR/dbus_system_$(date +%s).txt | \
      grep -iE "keyboard|hid|input|usb|258a|\
bluetooth|network" | while read line; do
        log "${MAGENTA}[DBUS] $line${RESET}"
    done &

    # Monitor session bus
    dbus-monitor --session 2>/dev/null | \
      tee $OUTDIR/dbus_session_$(date +%s).txt | \
      grep -iE "keyboard|hid|input|usb|258a|\
bluetooth|network|exec|spawn" | while read line; do
        log "${MAGENTA}[DBUS-SESSION] $line${RESET}"
    done &
}

# ---- FUNCTION: HID event tracker ----
track_hid() {
    log "${BOLD}${CYAN}=== HID TRACKER STARTED ===${RESET}"

    for event in event19 event21 event22 event28; do
        DEV="/dev/input/$event"
        [ -e "$DEV" ] || continue

        # Raw capture
        cat "$DEV" > \
          $OUTDIR/hid_raw_${event}_$(date +%s).bin &
        log "${CYAN}Raw capture: $event PID=$!${RESET}"

        # Decoded capture
        evtest "$DEV" 2>&1 | \
          tee $OUTDIR/hid_decoded_${event}_$(date +%s).txt | \
          while read line; do
            # Flag suspicious events
            if echo "$line" | grep -qiE \
              "KEY_|BTN_|ABS_|REL_|MSC_"; then
                TS=$(date '+%H:%M:%S.%N')
                log "${CYAN}[HID:$event] $TS $line${RESET}"

                # Check if any process just opened a socket
                # correlated with keypress
                ss -tupanoe 2>/dev/null | \
                  grep -v "LISTEN\|127.0.0.1" | \
                  tee -a $OUTDIR/socket_at_keypress.txt
            fi
        done &
    done
}

# ---- FUNCTION: inotify watcher ----
track_filesystem() {
    log "${BOLD}${WHITE}=== FILESYSTEM TRACKER STARTED ===${RESET}"

    inotifywait -m -r \
      /tmp /dev/input \
      /sys/bus/usb/devices/1-1/ \
      /sys/bus/hid/devices/ \
      /dev/bus/usb/001/ \
      --format '%T|%w|%f|%e|%0Xh' \
      --timefmt '%Y-%m-%d %H:%M:%S' \
      2>/dev/null | while IFS='|' read \
        TS DIR FILE EVENT COOKIE; do

        log "${WHITE}[FS] $TS $EVENT $DIR$FILE${RESET}"

        # If something wrote to a temp file
        # check who did it
        if echo "$EVENT" | grep -qE "CLOSE_WRITE|CREATE"; then
            WRITER=$(lsof "$DIR$FILE" 2>/dev/null | \
              awk 'NR>1 {print $2}' | head -1)
            if [ -n "$WRITER" ]; then
                log "${BOLD}${RED}[FS] WRITTEN BY PID: \
$WRITER $(cat /proc/$WRITER/cmdline 2>/dev/null | \
tr '\0' ' ')${RESET}"
                track_pid $WRITER "filesystem_write"
            fi
        fi
    done &
}

# ---- FUNCTION: Audit log watcher ----
track_audit() {
    log "${BOLD}${RED}=== AUDIT TRACKER STARTED ===${RESET}"

    # Watch audit log for honeypot keys
    tail -f /var/log/audit/audit.log 2>/dev/null | \
      grep --line-buffered \
      -iE "hid_honeypot|258a|event21|event22|event28" | \
      while read line; do
        log "${RED}[AUDIT] $line${RESET}"

        # Extract PID from audit record
        PID=$(echo "$line" | grep -oP 'pid=\K[0-9]+')
        if [ -n "$PID" ]; then
            track_pid $PID "audit_trigger"
        fi
    done &
}

# ---- FUNCTION: USB bus packet capture ----
track_usb_packets() {
    log "${BOLD}${GREEN}=== USB PACKET CAPTURE STARTED ===${RESET}"

    modprobe usbmon 2>/dev/null
    mount -t debugfs none /sys/kernel/debug 2>/dev/null

    # Capture on bus 1 (keyboard bus)
    tcpdump -i usbmon1 \
        -w $OUTDIR/usb_bus1_$(date +%s).pcap \
        -s 65535 &
    log "${GREEN}usbmon1 capture PID: $!${RESET}"

    # Live decode USB packets
    tcpdump -i usbmon1 -A -s 65535 2>/dev/null | \
      tee $OUTDIR/usb_live_$(date +%s).txt | \
      grep -v "^$" | while read line; do
        if echo "$line" | grep -qiE \
          "[0-9a-f]{8}|URB|SUBMIT|COMPLETE"; then
            log "${GREEN}[USB] $line${RESET}"
        fi
    done &
}

# ---- FUNCTION: Process scanner ----
track_new_processes() {
    log "${BOLD}${YELLOW}=== PROCESS TRACKER STARTED ===${RESET}"

    PREV_PIDS=$(ps -eo pid= 2>/dev/null | sort)

    (
        while true; do
            CURR_PIDS=$(ps -eo pid= 2>/dev/null | sort)
            NEW_PIDS=$(comm -13 \
              <(echo "$PREV_PIDS") \
              <(echo "$CURR_PIDS"))

            for PID in $NEW_PIDS; do
                CMD=$(cat /proc/$PID/cmdline \
                  2>/dev/null | tr '\0' ' ')
                PPID=$(cat /proc/$PID/status \
                  2>/dev/null | grep PPid | \
                  awk '{print $2}')
                PCMD=$(cat /proc/$PPID/cmdline \
                  2>/dev/null | tr '\0' ' ')

                log "${YELLOW}[NEWPROC] PID=$PID \
PPID=$PPID CMD=$CMD PARENT=$PCMD${RESET}"

                # Track anything suspicious
                if echo "$CMD $PCMD" | grep -qiE \
                  "curl|wget|nc|ncat|socat|python|\
perl|ruby|php|lua|sh|bash|exec|socket|258a|\
hid|input|usb|bluetooth|dbus"; then
                    log "${BOLD}${RED}[SUSPICIOUS PROC] \
$CMD${RESET}"
                    track_pid $PID "suspicious_process"
                fi
            done

            PREV_PIDS=$CURR_PIDS
            sleep 0.3
        done
    ) &
}

# ---- FUNCTION: Live display ----
live_display() {
    (
        while true; do
            clear
            echo -e "${BOLD}${GREEN}"
            echo "╔══════════════════════════════════════════╗"
            echo "║     CTW-11 HID HONEYPOT TRACKER          ║"
            echo "║     $(date '+%Y-%m-%d %H:%M:%S')              ║"
            echo "╚══════════════════════════════════════════╝"
            echo -e "${RESET}"

            echo -e "${CYAN}=== ACTIVE CAPTURES ===${RESET}"
            jobs -l | grep -v "Done\|Exit"

            echo -e "${RED}=== OPEN HID CONNECTIONS ===${RESET}"
            lsof /dev/input/event21 \
              /dev/input/event22 \
              /dev/input/event28 2>/dev/null | \
              grep -v "^COMMAND"

            echo -e "${YELLOW}=== ACTIVE NETWORK ===${RESET}"
            ss -tupanoe 2>/dev/null | \
              grep -v "LISTEN\|127.0.0.1\|::1" | \
              head -10

            echo -e "${MAGENTA}=== RECENT DBUS ===${RESET}"
            tail -3 $OUTDIR/dbus_system_*.txt \
              2>/dev/null | grep -v "^$"

