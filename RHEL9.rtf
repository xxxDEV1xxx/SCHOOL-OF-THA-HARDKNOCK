cat > /tmp/usb_reset_watchdog.sh << 'EOF'
#!/bin/bash
# CTW-11 USB 1-1 Error Reset Watchdog
# Monitors kernel feed for usb 1-1 errors
# Auto disconnect/reconnect on any error

LOG=/tmp/CTW_USB_RESET_$(date +%s).log

log() {
    echo "$(date '+%H:%M:%S.%N') $1" | \
      tee -a $LOG
}

reset_usb() {
    local reason="$1"
    log "RESET TRIGGERED: $reason"

    # Capture state before reset
    lsusb -t >> $LOG 2>/dev/null

    # Authorize=0 (disconnect)
    echo 0 > /sys/bus/usb/devices/1-1/authorized \
      2>/dev/null && \
      log "1-1 DISCONNECTED" || \
      log "DISCONNECT FAILED"

    sleep 1

    # Authorize=1 (reconnect)
    echo 1 > /sys/bus/usb/devices/1-1/authorized \
      2>/dev/null && \
      log "1-1 RECONNECTED" || \
      log "RECONNECT FAILED"

    # Log state after reset
    sleep 0.5
    lsusb -t >> $LOG 2>/dev/null

    log "RESET COMPLETE"
    log "---"
}

log "=== USB WATCHDOG STARTED ==="
log "Monitoring: usb 1-1 errors"
log "Action: auto reset on any error"

# Track reset count to detect reset loops
RESET_COUNT=0
LAST_RESET=0

# Monitor kernel ring buffer live
dmesg -w 2>/dev/null | \
  grep --line-buffered "usb 1-1" | \
  while read line; do

    # Log everything seen
    log "SEEN: $line"

    # Check if it's an error
    if echo "$line" | grep -qiE \
      "error|fail|reject|invalid|\
       reset|disconnect|not accept|\
       descriptor|timeout|babble|\
       -71|-32|-110|-104|-75|-22"; then

        # Rate limit — prevent reset storm
        NOW=$(date +%s)
        DELTA=$((NOW - LAST_RESET))

        if [ $DELTA -lt 3 ]; then
            log "RATE LIMITED: $DELTA s since last reset"
            continue
        fi

        RESET_COUNT=$((RESET_COUNT + 1))
        LAST_RESET=$NOW

        log "ERROR #$RESET_COUNT: $line"
        reset_usb "$line"

        # After 5 resets in session
        # escalate — block entirely
        if [ $RESET_COUNT -ge 5 ]; then
            log "ESCALATION: 5 resets — blocking 1-1"
            echo 0 > \
              /sys/bus/usb/devices/1-1/authorized \
              2>/dev/null
            log "1-1 PERMANENTLY BLOCKED this session"
            log "Errors: $(grep RESET $LOG | wc -l)"
