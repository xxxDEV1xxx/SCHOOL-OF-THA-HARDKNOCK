thank you, two more for our stock rocky, no extra installsbor onternet. we need encrypted dns, ipv6 in/out, but turned to ipv4 on the internal network to filter traffic more easily. then no ipv4 dns only ipv6
Jun 1

Both of these are achievable with stock Rocky tools — no extra installs needed since systemd-resolved is already present.

Part 1 — Encrypted DNS over IPv6 only, no IPv4 DNS:
bash

# Verify systemd-resolved is present
systemctl status systemd-resolved | head -3
ls /etc/systemd/resolved.conf

bash

# Configure resolved for DoT over IPv6 only
cat > /etc/systemd/resolved.conf << 'EOF'
[Resolve]
# Encrypted DNS servers — IPv6 only
# Cloudflare DoT IPv6
DNS=2606:4700:4700::1111#cloudflare-dns.com
DNS=2606:4700:4700::1001#cloudflare-dns.com

# Quad9 DoT IPv6
FallbackDNS=2620:fe::fe#dns.quad9.net
FallbackDNS=2620:fe::9#dns.quad9.net

# Force DNS over TLS — never plaintext
DNSOverTLS=yes

# DNSSEC validation
DNSSEC=yes

# No mDNS — attack surface
MulticastDNS=no

# No LLMNR — attack surface
LLMNR=no

# Cache
Cache=yes
CacheFromLocalhost=no

# No IPv4 DNS ever
# IPv6 transport only
EOF

bash

# Enable and start resolved
systemctl enable --now systemd-resolved

# Link resolv.conf to resolved stub
ln -sf \
  /run/systemd/resolve/stub-resolv.conf \
  /etc/resolv.conf

# Verify resolv.conf is correct
cat /etc/resolv.conf
# Should show: nameserver 127.0.0.53

bash

# Verify DoT is working
resolvectl status | grep -iE \
  "dns.*over.*tls|dot|protocol|server"

# Test resolution
resolvectl query cloudflare.com
resolvectl statistics

bash

# Block any IPv4 DNS escaping the system
# Add to nftables — already have the conf
cat >> /etc/nftables.conf << 'EOF'

# ============================================================
# DNS ENFORCEMENT
# IPv6 DoT only — block all IPv4 DNS
# ============================================================
table inet ctw_dns {

    chain dns_enforce {
        type filter hook output priority -200
        policy accept

        # Block ANY IPv4 DNS leaving system
        # Forces all DNS through resolved stub
        ip protocol udp \
            udp dport 53 \
            oif != lo \
            log prefix "CTW-IPV4DNS-BLOCK: " \
            drop

        ip protocol tcp \
            tcp dport 53 \
            oif != lo \
            log prefix "CTW-IPV4DNS-BLOCK: " \
            drop

        # Block IPv4 DoT (port 853)
        # Only IPv6 DoT allowed
        ip protocol tcp \
            tcp dport 853 \
            log prefix "CTW-IPV4DOT-BLOCK: " \
            drop

        # Allow IPv6 DoT outbound
        ip6 nexthdr tcp \
            tcp dport 853 \
            accept

        # Block DNS-over-HTTPS on IPv4
        ip protocol tcp \
            tcp dport 443 \
            ip daddr != 0.0.0.0/0 \
            meta skuid != 0 \
            log prefix "CTW-IPV4DOH: " \
            drop
    }

    chain dns_intercept {
        type nat hook prerouting priority -100
        policy accept

        # Intercept any plain DNS
        # redirect to local resolver
        ip protocol udp \
            udp dport 53 \
            redirect to :53

        ip protocol tcp \
            tcp dport 53 \
            redirect to :53
    }
}
EOF

nft -f /etc/nftables.conf

Part 2 — IPv6 WAN, NAT64/DNS64 for internal IPv4:
bash

# Configure NetworkManager for dual stack
# IPv6 native on WAN
# IPv4 internal only — never leaves the box

cat > /etc/NetworkManager/conf.d/ctw-ipv6.conf << 'EOF'
[main]
# Prefer IPv6
dns=systemd-resolved

[connection]
# IPv6 by default on all connections
ipv6.method=auto
ipv4.method=auto

# Never use IPv4 DNS
ipv4.ignore-auto-dns=yes
ipv6.ignore-auto-dns=no
EOF

bash

# Configure network interface
# Replace eth0 with your interface name
IFACE=$(ip route | grep default | \
  awk '{print $5}' | head -1)
echo "Interface: $IFACE"

# Set IPv6 sysctl hardening
cat > /etc/sysctl.d/99-ctw-ipv6.conf << 'EOF'
# IPv6 — enable and harden
net.ipv6.conf.all.disable_ipv6=0
net.ipv6.conf.default.disable_ipv6=0

# Privacy extensions RFC 4941
# Rotate IPv6 address periodically
net.ipv6.conf.all.use_tempaddr=2
net.ipv6.conf.default.use_tempaddr=2

# Accept RA from router only
net.ipv6.conf.all.accept_ra=1
net.ipv6.conf.default.accept_ra=1

# No redirects
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.default.accept_redirects=0
net.ipv6.conf.all.send_redirects=0

# No source routing
net.ipv6.conf.all.accept_source_route=0

# Enhanced DAD RFC 7527
net.ipv6.conf.all.enhanced_dad=1
net.ipv6.conf.default.enhanced_dad=1

# Drop unsolicited NA (NDP spoofing)
net.ipv6.conf.all.drop_unsolicited_na=1

# Suppress fragmented NDP
net.ipv6.conf.all.suppress_frag_ndisc=1

# IPv4 hardening — internal only
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.all.rp_filter=1
net.ipv4.conf.all.log_martians=1
net.ipv4.conf.default.rp_filter=1

# Prevent IPv4 DNS from routing out
# IPv4 is internal only
net.ipv4.conf.all.mc_forwarding=0

# TCP hardening
net.ipv4.tcp_syncookies=1
net.ipv4.tcp_rfc1337=1
net.ipv4.tcp_timestamps=0
net.ipv4.tcp_sack=0
net.ipv4.tcp_dsack=0
net.ipv4.tcp_fack=0
EOF

sysctl -p /etc/sysctl.d/99-ctw-ipv6.conf

bash

# NAT64 via DNS64 in resolved
# When IPv4-only site requested:
# resolved synthesizes AAAA from A record
# Traffic goes over IPv6 to NAT64 gateway

# Add DNS64 to resolved config
cat >> /etc/systemd/resolved.conf << 'EOF'

# DNS64 — synthesize IPv6 for IPv4 sites
# Uses well-known NAT64 prefix 64:ff9b::/96
DNS64=yes
EOF

systemctl restart systemd-resolved

bash

# Add NAT64 nftables rules
cat >> /etc/nftables.conf << 'EOF'

# ============================================================
# NAT64 — IPv4 internal to IPv6 external
# ============================================================
table ip ctw_nat64 {

    chain postrouting {
        type nat hook postrouting priority 100
        policy accept

        # Masquerade IPv4 LAN traffic
        # going to NAT64 prefix
        ip daddr 192.168.0.0/16 \
            masquerade

        # IPv4 loopback always ok
        oif lo accept
    }
}

# IPv6 — allow NAT64 prefix through
table ip6 ctw_nat64_v6 {

    chain forward_nat64 {
        type filter hook forward priority 0
        policy accept

        # Allow NAT64 synthesized traffic
        # prefix 64:ff9b::/96
        ip6 daddr 64:ff9b::/96 accept
        ip6 saddr 64:ff9b::/96 accept
    }
}

EOF

nft -f /etc/nftables.conf

bash

# Final verification
echo "=== DNS VERIFICATION ==="
resolvectl status | grep -iE \
  "server|tls|dnssec|protocol"

echo ""
echo "=== IPv6 STATUS ==="
ip -6 addr show
ip -6 route show

echo ""
echo "=== SYSCTL CHECK ==="
sysctl net.ipv6.conf.all.use_tempaddr
sysctl net.ipv4.conf.all.accept_redirects
sysctl net.ipv4.tcp_syncookies

echo ""
echo "=== NFT DNS RULES ==="
nft list table inet ctw_dns 2>/dev/null | \
  grep -c "drop\|accept"
echo "DNS enforcement rules loaded"

echo ""
echo "=== resolv.conf ==="
cat /etc/resolv.conf

echo ""
echo "=== TEST RESOLUTION ==="
resolvectl query example.com 2>/dev/null | \
  head -5

bash

# Make everything survive reboot
systemctl enable systemd-resolved
systemctl enable nftables
sysctl --system

echo "=== ALL DONE ==="
echo "DNS:  Encrypted DoT over IPv6 only"
echo "WAN:  IPv6 native"
echo "LAN:  IPv4 internal — never exits"
echo "NAT64: IPv4 sites routed via IPv6"
echo "IPv4 DNS: Blocked at nftables layer"

Summary of what this builds:

DNS path:
  App requests DNS
  → systemd-resolved (127.0.0.53)
  → DoT over IPv6 only (port 853)
  → Cloudflare/Quad9 via IPv6
  → DNSSEC validated
  → cached locally
  → returned to app

  IPv4 DNS: nftables drops it
  Plain DNS: intercepted → resolved
  DoH on IPv4: blocked

IPv6 WAN:
  Privacy extensions = rotating addresses
  Enhanced DAD = cryptographic uniqueness
  No redirects = no MITM
  No unsolicited NA = no NDP spoofing
  Fragmented NDP dropped

IPv4 internal:
  rp_filter = anti-spoof
  No redirects, no source routing
  Martians logged
  Never exits as DNS transport

NAT64:
  IPv4-only sites still work
  Traffic synthesized to IPv6 AAAA
  Routed via 64:ff9b::/96 prefix
  Internal IPv4 stays internal

Paste resolvectl status after restart — confirms DoT is negotiating over IPv6 before we call it done.

