#!/bin/bash
# Feed TPM randomness to kernel entropy pool
# Runs at boot via systemd

while true; do
    # Get 32 bytes of TPM randomness
    RAND=$(tpm2_getrandom \
      --hex 32 2>/dev/null)

    if [ -n "$RAND" ]; then
        # Write to kernel entropy pool
        echo -ne "$RAND" | \
          dd of=/dev/random \
