#!/bin/bash
RESULTS=/tmp/kernel_audit_results.txt

echo "Building validated bootargs..."
echo ""

ARGS="ip=192.168.4.20::192.168.4.254:255.255.255.0:prplhaze:eth0:off"
ARGS="$ARGS console=ttyMSM0,115200n8"
ARGS="$ARGS clk_ignore_unused"

# Only add if confirmed VALID
while read line; do
    if echo "$line" | grep -q "VALID.*init_on_alloc"; then
        ARGS="$ARGS init_on_alloc=1"
    fi
    if echo "$line" | grep -q "VALID.*init_on_free"; then
        ARGS="$ARGS init_on_free=1"
    fi
    if echo "$line" | grep -q "VALID.*slab_nomerge"; then
        ARGS="$ARGS slab_nomerge"
    fi
    if echo "$line" | grep -q "VALID.*page_alloc"; then
        ARGS="$ARGS page_alloc.shuffle=1"
    fi
    if echo "$line" | grep -q "VALID.*kstack"; then
        ARGS="$ARGS randomize_kstack_offset=on"
    fi
    if echo "$line" | grep -q "VALID.*vsyscall"; then
        ARGS="$ARGS vsyscall=none"
    fi
    if echo "$line" | grep -q "VALID.*debugfs"; then
        ARGS="$ARGS debugfs=off"
    fi
    if echo "$line" | grep -q "VALID.*lockdown"; then
        ARGS="$ARGS lockdown=confidentiality"
    fi
    if echo "$line" | grep -q "VALID.*oops"; then
        ARGS="$ARGS oops=panic panic=5 panic_on_oops=1"
    fi
    if echo "$line" | grep -q "VALID.*slub_debug"; then
        ARGS="$ARGS slub_debug=FZP"
    fi
    if echo "$line" | grep -q "VALID.*kfence"; then
        ARGS="$ARGS kfence.sample_interval=100"
    fi
    if echo "$line" | grep -q "VALID.*iommu"; then
        ARGS="$ARGS iommu.strict=1 iommu.passthrough=0"
    fi
done < $RESULTS

echo "VALIDATED BOOTARGS:"
echo "$ARGS"
echo ""
echo "FLAGS REMOVED (not in kernel):"
grep "INVALID\|NOT_FOUND" $RESULTS | \
  awk '{print "  REMOVED:", $NF}'
EOF

