rpm -q shim-x64
# Must be 15.8-2.el9 or newer before doing this

# Restore current revocation policy
mokutil --set-sbat-policy latest

# Reboot to let shim write the new SBAT into NVRAM
systemctl reboot

After reboot:
bash

# Confirm SBAT is sane
mokutil --list-sbat-revocations
# Should show: shim,4 or shim,5 — not the old revoked entries

# Confirm dbx is populated
dbxtool -l | wc -l

If dbxtool -u fails with a permission error:
