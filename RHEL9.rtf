        icmpv6 type {
            echo-reply,           # ping response
            destination-unreachable,
            packet-too-big,       # PMTUD — required
            time-exceeded,
            parameter-problem,
            nd-neighbor-solicit,  # NDP
            nd-neighbor-advert,
            nd-router-advert,     # RA from upstream
            mld-listener-query    # Multicast
