        done
    ) &
}

# ---- START ALL TRACKERS ----
track_hid
track_network
track_dbus
track_filesystem
track_audit
track_usb_packets
track_new_processes
live_display

log "${BOLD}${GREEN}All trackers running. \
Output: $OUTDIR${RESET}"
log "Stop with: bash /tmp/honeypot/stop_deep.sh"

# Keep script alive
wait
