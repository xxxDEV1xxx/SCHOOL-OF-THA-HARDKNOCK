# Download the current UEFI dbx update from Microsoft
curl -L -o /tmp/dbxupdate.bin \
  https://uefi.org/sites/default/files/resources/dbxupdate_x64.bin

# Check it
dbxtool -l -f /tmp/dbxupdate.bin | head -20

# Apply it
dbxtool -u /tmp/dbxupdate.bin

# Verify it loaded
