Encrypted DNS — DoT (DNS over TLS) on IPv6 only:

The router intercepts all port 53 (plain DNS) from LAN and redirects to local resolver (Unbound or stubby) which:

    Only uses IPv6 upstream
    Only speaks DoT (port 853) or DoH (port 443)
    Validates DNSSEC
    Returns synthesized AAAA records for DNS64

bash

# Intercept plain DNS — add to nftables
cat << 'EOF' >> /etc/nftables.d/wan-lockdown.nft

table inet dns_enforcement {
    chain dns_intercept {
        type nat hook prerouting priority -100;

        # Redirect all LAN DNS to local resolver
        iifname "br-lan" udp dport 53 \
            redirect to :5353
        iifname "br-lan" tcp dport 53 \
            redirect to :5353

        # Block any DNS trying to escape to WAN directly
        # (bypassing the encrypted resolver)
        oifname "eth0" udp dport 53 drop
        oifname "eth0" tcp dport 53 drop

        # Only allow DoT and DoH out
        # (ports 853 and 443)
    }
}
EOF

