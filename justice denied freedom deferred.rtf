#!/bin/bash
# CTW-11 Fake Backend + PPP Purge Script
# Fedora 9 / sbin cleanup with SHA1 forensic archive

ARCHIVE_DIR="/root/forensic_purge_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$ARCHIVE_DIR"

echo "[*] Archiving and purging targets..."

purge_target() {
    local TARGET="$1"
    if [ -e "$TARGET" ] || [ -L "$TARGET" ]; then
        SHA=$(sha1sum "$TARGET" 2>/dev/null | awk '{print $1}')
        BASENAME=$(basename "$TARGET")
        tar -cf "${ARCHIVE_DIR}/${BASENAME}_${SHA}.tar" "$TARGET" 2>/dev/null
        echo "$SHA  $TARGET" >> "${ARCHIVE_DIR}/manifest.sha1"
        rm -f "$TARGET"
        echo "[+] Purged: $TARGET (SHA1: $SHA)"
    fi
}

# PPP targets
for f in $(find /usr/sbin /sbin /usr/bin /bin -name "*ppp*" -o -name "*pppoe*" -o -name "*ippp*" 2>/dev/null); do
    purge_target "$f"
done

# Fake Net backend
for f in $(find / -name "*fakenet*" -o -name "*fake_net*" -o -name "*FakeNet*" 2>/dev/null); do
    purge_target "$f"
done

# Fake Bluetooth backend
for f in $(find / -name "*fakebluetooth*" -o -name "*fake_bluetooth*" -o -name "*FakeBluetooth*" 2>/dev/null); do
    purge_target "$f"
done

# Solid KDE backend configs referencing Fake backends
for f in $(grep -rl "FakeNet\|FakeBluetooth" /etc /usr/share /usr/lib 2>/dev/null); do
    purge_target "$f"
done

echo "[*] Done. Forensic archive: $ARCHIVE_DIR"
echo "[*] Manifest:"
cat "${ARCHIVE_DIR}/manifest.sha1"

