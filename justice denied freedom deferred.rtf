#!/bin/bash
# CTW-11 Fedora 9 DVD Package Reinstall Script
# Safe bulk rpm -U with dependency order protection

PACKAGE_LIST="/home/packages.txt"
DVD_PATH="/media/Fedora 9 i386 DVD/Packages"
LOG="/root/ctw11_rpm_reinstall_$(date +%Y%m%d_%H%M%S).log"
SKIP_LOG="/root/ctw11_rpm_SKIPPED_$(date +%Y%m%d_%H%M%S).log"

# ─────────────────────────────────────────────
# CRITICAL: DO NOT REINSTALL THESE FIRST
# These packages underpin SELinux policy loading,
# PAM auth stack, and the GDM/X11 login layer.
# They must be deferred to LAST or skipped entirely
# if the system is live — reinstalling them mid-session
# can break the running auth stack and lock you out.
# ─────────────────────────────────────────────
DEFER_LIST=(
    "selinux-policy"
    "selinux-policy-targeted"
    "libselinux"
    "libselinux-utils"
    "libsepol"
    "libsemanage"
    "checkpolicy"
    "policycoreutils"
    "pam"
    "pam_krb5"
    "pam_smb"
    "shadow-utils"
    "audit"
    "audit-libs"
    "glibc"
    "glibc-common"
    "ld-linux"
    "libgcc"
    "libstdc++"
    "nss"
    "nss-tools"
    "nspr"
    "dbus"
    "dbus-libs"
    "gdm"
    "gdm-plugin-smartcard"
    "xorg-x11-server-Xorg"
    "xorg-x11-xinit"
    "gtk2"
    "gdk-pixbuf"
    "cairo"
    "pango"
    "atk"
    "rpm"
    "rpm-libs"
    "rpm-python"
    "bash"
    "coreutils"
    "util-linux"
    "udev"
    "hal"
    "dbus-glib"
)

is_deferred() {
    local pkg="$1"
    for d in "${DEFER_LIST[@]}"; do
        if [[ "$pkg" == "$d"* ]]; then
            return 0
        fi
    done
    return 1
}

echo "[*] CTW-11 RPM Reinstall Started: $(date)" | tee -a "$LOG"
echo "[*] Source: $DVD_PATH" | tee -a "$LOG"
echo "[*] Package list: $PACKAGE_LIST" | tee -a "$LOG"
echo "─────────────────────────────────────────" | tee -a "$LOG"

DEFERRED=()

while IFS= read -r PKG_NAME || [[ -n "$PKG_NAME" ]]; do
    # Skip blank lines and comments
    [[ -z "$PKG_NAME" || "$PKG_NAME" == \#* ]] && continue

    # Find matching RPM on DVD
    RPM_FILE=$(find "$DVD_PATH" -name "${PKG_NAME}*.rpm" 2>/dev/null | head -1)

    if [[ -z "$RPM_FILE" ]]; then
        echo "[MISSING] $PKG_NAME — no RPM found on DVD" | tee -a "$LOG" "$SKIP_LOG"
        continue
    fi

    # Check if deferred
    if is_deferred "$PKG_NAME"; then
        echo "[DEFER]   $PKG_NAME → queued for end-of-run" | tee -a "$LOG"
        DEFERRED+=("$RPM_FILE")
        continue
    fi

    echo "[INSTALL] $PKG_NAME" | tee -a "$LOG"
    rpm -U "$RPM_FILE" --replacefiles --replacepkgs 2>&1 | tee -a "$LOG"

done < "$PACKAGE_LIST"

# ─────────────────────────────────────────────
# DEFERRED PASS — SELinux / PAM / GDM / glibc
# Run these last, in a single rpm transaction
# to minimize window where auth stack is inconsistent
# ─────────────────────────────────────────────
if [[ ${#DEFERRED[@]} -gt 0 ]]; then
    echo "" | tee -a "$LOG"
    echo "─────────────────────────────────────────" | tee -a "$LOG"
    echo "[*] Beginning deferred critical packages: $(date)" | tee -a "$LOG"
    echo "[!] WARNING: Do not interrupt this phase" | tee -a "$LOG"
    echo "─────────────────────────────────────────" | tee -a "$LOG"

    rpm -U "${DEFERRED[@]}" --replacefiles --replacepkgs 2>&1 | tee -a "$LOG"

    echo "[*] Deferred phase complete: $(date)" | tee -a "$LOG"
fi

echo "" | tee -a "$LOG"
echo "─────────────────────────────────────────" | tee -a "$LOG"
echo "[*] Reinstall complete: $(date)" | tee -a "$LOG"
echo "[*] Full log: $LOG" | tee -a "$LOG"
echo "[*] Skipped: $SKIP_LOG" | tee -a "$LOG"

# ─────────────────────────────────────────────
# POST-RUN: Restore SELinux contexts
# Required after any lib/policy replacement
# ─────────────────────────────────────────────
echo "[*] Restoring SELinux file contexts..." | tee -a "$LOG"
restorecon -Rv /lib /usr/lib /etc/pam.d /etc/security 2>&1 | tee -a "$LOG"

echo "[*] Done." | tee -a "$LOG"

Critical packages noted and why:

SELinux layer — deferred:

    selinux-policy*, libselinux, libsepol, libsemanage, policycoreutils — replacing these mid-session can drop enforcement mode and break subsequent policy loads

PAM/auth stack — deferred:

    pam, shadow-utils, audit* — live replacement can immediately break su, sudo, login

GDM/X11 login layer — deferred:

    gdm, xorg-x11-server-Xorg, gtk2, dbus* — replacing while X is running will crash the display session

glibc — deferred:

    glibc, libgcc, libstdc++ — every running process links against these; replacing live is high-risk

Run this from a TTY (Ctrl+Alt+F2), not inside a terminal emulator under GDM, so if X crashes during the deferred phase you still have console access.

