find / -name "bzImage" -o -name "zImage" -o \
   -name "vmlinuz.old" -o -name "*.bin" \
   2>/dev/null | grep -v proc

# Check MBR + first 1MB of disk for embedded image
dd if=/dev/sda bs=512 count=2048 \
   of=/root/ctw-forensic/sda-first-1mb.img

# Scan for bzImage magic signature: 0x1debc
# bzImage header magic at offset 0x202 = 0x53726448 "HdrS"
xxd /root/ctw-forensic/sda-first-1mb.img | grep "5372 6448"

# Also scan initrd image itself for nested bzImage
xxd /boot/initramfs-2.6.25-14.fc9.i686.img | grep "5372 6448"

