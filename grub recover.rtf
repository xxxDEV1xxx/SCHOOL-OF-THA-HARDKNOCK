dd if=/path/to/bzImage bs=1 skip=500 count=4 | xxd  # syssize
dd if=/path/to/bzImage bs=1 skip=514 count=4 | xxd  # HdrS magic
dd if=/path/to/bzImage bs=1 skip=518 count=2 | xxd  # version
dd if=/path/to/bzImage bs=1 skip=524 count=4 | xxd  # code32_start

