#!/bin/bash
# CTW-11 COM1 Forensic Listener
# Captures all serial traffic with timestamps
# Runs BEFORE boot sequence where possible

OUTFILE="/home/com1-capture-$(date +%Y%m%d-%H%M%S).txt"
RAWFILE="/home/com1-raw-$(date +%Y%m%d-%H%M%S).bin"

echo "CTW-11 COM1 LISTENER - $(date)" | tee "$OUTFILE"
echo "==============================" | tee -a "$OUTFILE"

# Configure COM1 for raw capture
# 9600 baud 8N1 — SIR IrDA default speed
stty -F /dev/ttyS0 9600 cs8 -cstopb -parenb raw -echo

echo "[*] COM1 configured: 9600 8N1 raw" | tee -a "$OUTFILE"
echo "[*] IrDA SIR baseline capture started" | tee -a "$OUTFILE"
echo "[*] Output: $RAWFILE" | tee -a "$OUTFILE"
echo "" | tee -a "$OUTFILE"

python -c "
import sys, time, os

dev = open('/dev/ttyS0', 'rb', buffering=0)
raw = open('$RAWFILE', 'wb')
log = open('$OUTFILE', 'a')
out = sys.stdout

start = time.time()
byte_count = 0
last_activity = time.time()

def hexdump(data, offset):
    lines = []
    for i in range(0, len(data), 16):
        row = data[i:i+16]
        hex_part = ' '.join('%02x' % (b if isinstance(b,int) else ord(b)) 
                           for b in row)
        asc_part = ''.join(
            chr(b if isinstance(b,int) else ord(b)) 
            if 32 <= (b if isinstance(b,int) else ord(b)) < 127 
            else '.' for b in row)
        lines.append('%08X  %-48s  |%s|' % (offset+i, hex_part, asc_part))
    return '\n'.join(lines)

buf = bytearray()
import select

print('[*] Listening on COM1/ttyS0...')
print('[*] Press Ctrl+C to stop')
print()

try:
    while True:
        r,_,_ = select.select([dev],[],[],2.0)
        if r:
            byte = dev.read(1)
            if byte:
                raw.write(byte)
                raw.flush()
                buf += byte
                byte_count += 1
                last_activity = time.time()

                # Print hex dump every 16 bytes
                if len(buf) >= 16:
                    ts = '%.3f' % (time.time()-start)
                    line = '[%s] %s' % (ts, hexdump(bytes(buf[:16]), byte_count-16))
                    print(line)
                    log.write(line+'\n')
                    log.flush()
                    buf = buf[16:]
        else:
            # Timeout — print any remaining buffer
            if buf:
                ts = '%.3f' % (time.time()-start)
                line = '[%s] %s' % (ts, hexdump(bytes(buf), byte_count-len(buf)))
                print(line)
                log.write(line+'\n')
                log.flush()
                buf = bytearray()
            else:
                idle = time.time()-last_activity
                sys.stdout.write('\r[idle %.0fs] %d bytes captured' % (idle,byte_count))
                sys.stdout.flush()

except KeyboardInterrupt:
    print()
    print('[*] Capture stopped')
    print('[*] Total bytes: %d' % byte_count)
    log.write('Total bytes: %d\n' % byte_count)

dev.close()
raw.close()
log.close()
" 2>/dev/null

