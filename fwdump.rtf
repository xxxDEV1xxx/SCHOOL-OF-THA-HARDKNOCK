#!/bin/bash
# CTW-11 PNG Entropy + Steganography Audit
# Detects: anomalous entropy, LSB steg, appended data, oversized chunks
# SDAR output: /home/png-steg-audit.txt

OUTFILE="/home/png-steg-audit.txt"
FLAGGED=0
SCANNED=0

echo "============================================" | tee "$OUTFILE"
echo " CTW-11 PNG STEG/ENTROPY AUDIT" | tee -a "$OUTFILE"
echo " $(date)" | tee -a "$OUTFILE"
echo "============================================" | tee -a "$OUTFILE"

# Resolve symlinks to real files — deduplicate targets
# We audit the REAL file, not the link
declare -A SEEN

while IFS= read -r png; do

    # Resolve to canonical real path
    real=$(readlink -f "$png" 2>/dev/null)
    [ -z "$real" ] && real="$png"
    [ -f "$real" ] || continue

    # Skip already-audited real files
    [ "${SEEN[$real]+_}" ] && continue
    SEEN[$real]=1

    SCANNED=$((SCANNED + 1))
    FLAGS=""

    # --- CHECK 1: Valid PNG header ---
    header=$(xxd -l 8 "$real" 2>/dev/null | awk '{print $2$3}')
    if [ "$header" != "89504e47" ]; then
        FLAGS+="[NOT-PNG-HEADER:$header] "
    fi

    # --- CHECK 2: File size vs resolution ratio ---
    # Extract width/height from IHDR (bytes 16-23)
    width_hex=$(xxd -s 16 -l 4 "$real" 2>/dev/null | awk '{print $2$3}' | tr -d ' ')
    height_hex=$(xxd -s 20 -l 4 "$real" 2>/dev/null | awk '{print $2$3}' | tr -d ' ')
    width=$((16#${width_hex}))
    height=$((16#${height_hex}))
    filesize=$(stat -c%s "$real" 2>/dev/null)

    if [ "$width" -gt 0 ] && [ "$height" -gt 0 ] && [ "$filesize" -gt 0 ]; then
        pixels=$((width * height))
        # Ratio: bytes per pixel — icons should be <5 bytes/pixel typically
        # Anything >20 bytes/pixel for a small icon = anomalous
        if [ "$pixels" -gt 0 ]; then
