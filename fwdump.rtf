#!/bin/bash
# CTW-11 IrDA/Serial Lockdown
# Run AFTER baseline capture
# Blocks all IrDA and unauthorized COM access

OUTFILE="/home/irda-lockdown-$(date +%Y%m%d).txt"

echo "CTW-11 IrDA LOCKDOWN - $(date)" | tee "$OUTFILE"

# 1. Unload all IrDA kernel modules
echo "[*] Unloading IrDA stack..." | tee -a "$OUTFILE"
for mod in ircomm_tty ircomm irlan irnet irtty_sir \
           irda_usb sir_dev irda; do
    rmmod --force $mod 2>/dev/null && \
        echo "  REMOVED: $mod" | tee -a "$OUTFILE"
done

# 2. Blacklist all IrDA modules
cat >> /etc/modprobe.d/blacklist.conf << 'EOF'
# CTW-11 IrDA lockdown
blacklist irda
blacklist irtty_sir
blacklist sir_dev
blacklist ircomm
blacklist ircomm_tty
blacklist irlan
blacklist irnet
blacklist irda_usb
install irda /bin/true
install irtty_sir /bin/true
install sir_dev /bin/true
EOF
echo "[*] IrDA modules blacklisted" | tee -a "$OUTFILE"

# 3. Lock COM port device files
# Preserve one controlled instance for our listener
chmod 000 /dev/ttyS0
chmod 000 /dev/ttyS1
chmod 000 /dev/ttyS2
chmod 000 /dev/ttyS3
echo "[*] ttyS* locked to 000" | tee -a "$OUTFILE"

# 4. Verify no process holds COM open
lsof /dev/ttyS* 2>/dev/null | tee -a "$OUTFILE"

# 5. UDEV rule — block any future IrDA device binding
cat > /etc/udev/rules.d/99-ctw11-irda-block.rules << 'EOF'
# CTW-11: Block IrDA device creation
SUBSYSTEM=="irda", ACTION=="add", RUN+="/bin/false"
KERNEL=="ircomm*", ACTION=="add", RUN+="/bin/false"  
KERNEL=="ttyS*", ACTION=="add", MODE="000"
EOF
echo "[*] udev rules installed" | tee -a "$OUTFILE"

# 6. Verify UART state — read Line Status Register
python -c "
try:
    f = open('/dev/port','rb')
    # COM1 base 0x3F8
    regs = {
        0x3F8: 'RBR/THR (data)',
        0x3F9: 'IER (interrupts)',
        0x3FA: 'IIR (int ID)',
        0x3FB: 'LCR (line ctrl)',
        0x3FC: 'MCR (modem ctrl)',
        0x3FD: 'LSR (line status)',
        0x3FE: 'MSR (modem status)',
    }
    print('COM1 UART Register Dump:')
    for addr, name in sorted(regs.items()):
        f.seek(addr)
        val = ord(f.read(1))
        print('  0x%03X %-20s = 0x%02X (%08s)' % (
            addr, name, val, bin(val)[2:].zfill(8)))
    f.close()
except Exception as e:
    print('Error:', e)
" 2>/dev/null | tee -a "$OUTFILE"

echo "" | tee -a "$OUTFILE"
echo "[*] Lockdown complete" | tee -a "$OUTFILE"
echo "[*] Log: $OUTFILE" | tee -a "$OUTFILE"

