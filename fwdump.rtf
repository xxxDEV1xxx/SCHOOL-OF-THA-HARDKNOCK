#!/bin/bash
# CTW-11 Asymmetric Symlink Name Scanner
# Detects symlinks where basename(link) != basename(target)
# SDAR output: /home/asymlink-findings.txt

OUTFILE="/home/asymlink-findings.txt"
TMPFILE="/tmp/.asymlink_tmp_$$"

# Scan order: system-critical first, branch outward
SCAN_DIRS=(
    /bin /sbin /lib /lib64
    /etc /boot
    /usr/bin /usr/sbin /usr/lib /usr/lib64
    /usr/share
    /lib/firmware
    /var /opt /srv
    /home /root
    /tmp /dev/shm
)

echo "============================================" | tee "$OUTFILE"
echo " CTW-11 ASYMMETRIC SYMLINK SCAN" | tee -a "$OUTFILE"
echo " $(date)" | tee -a "$OUTFILE"
echo "============================================" | tee -a "$OUTFILE"
echo "" | tee -a "$OUTFILE"

TOTAL=0

for DIR in "${SCAN_DIRS[@]}"; do
    [ -d "$DIR" ] || continue

    SECTION_HITS=0
    SECTION_OUT=""

    while IFS= read -r link; do
        target=$(readlink "$link" 2>/dev/null)
        [ -z "$target" ] && continue

        link_base=$(basename "$link")
        target_base=$(basename "$target")

        if [ "$link_base" != "$target_base" ]; then
            LINE="[ASYMMETRIC] $link -> $target"
            SECTION_OUT+="$LINE"$'\n'
            SECTION_HITS=$((SECTION_HITS + 1))
            TOTAL=$((TOTAL + 1))
        fi

    done < <(find "$DIR" -xdev -type l 2>/dev/null)

    if [ $SECTION_HITS -gt 0 ]; then
        {
            echo "--- $DIR ($SECTION_HITS hits) ---"
            echo "$SECTION_OUT"
        } | tee -a "$OUTFILE"
    fi

done

echo "" | tee -a "$OUTFILE"
echo "============================================" | tee -a "$OUTFILE"
echo " TOTAL ASYMMETRIC SYMLINKS: $TOTAL" | tee -a "$OUTFILE"
echo " Full log: $OUTFILE" | tee -a "$OUTFILE"
echo "============================================" | tee -a "$OUTFILE"

