# Cortex-A55 erratum — speculative execution past TLBI
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_1024718=y

# ── 2. TIMER/INTERRUPT SIDE CHANNELS ─────────────────────────────────────
# High resolution timers are the primitive for EVERY cache
# timing attack — Spectre, Rowhammer, DRAMA, Prime+Probe.
# Coarsen timer resolution — removes the measurement primitive
# without breaking legitimate time functions.
CONFIG_HZ=250
# Disable: CONFIG_HZ_1000 is not set
# jiffies-based coarsening — 4ms resolution minimum
CONFIG_TIMER_STATS=n
# Disable perf for attacker use — still logs to our honeypot
# via kernel tracepoints which are separate infrastructure
CONFIG_PERF_EVENTS=n
# CONFIG_HW_PERF_EVENTS is not set
# This removes the hardware PMU interface entirely —
# PMU counters are the OTHER primitive for cache timing attacks
# (LLC miss counting tells you exactly what cache lines were evicted)

# ── 3. ROWHAMMER ─────────────────────────────────────────────────────────
# Repeated DRAM row access flips bits in adjacent rows.
# No software fix exists but we can remove the access primitives:
# Disable transparent huge pages — large contiguous physical
# allocations make rowhammer targeting trivially easy
CONFIG_TRANSPARENT_HUGEPAGE=n
# Disable: CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
# Disable: CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# ── 4. HEAP LAYOUT MANIPULATION ──────────────────────────────────────────
# Attackers groom heap layout to place controlled data
# adjacent to target objects. These options randomize and
# harden allocation patterns to defeat grooming.
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
# Cross-cache attacks: object type confusion via slab reuse
# Dedicated caches prevent type confusion between object types
CONFIG_MEMCG=y
# Virtual address space layout randomization for slab
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
# Prevent use-after-free exploitation via page quarantine
CONFIG_PAGE_POISONING=y
CONFIG_PAGE_POISONING_NO_SANITY=n
CONFIG_PAGE_POISONING_ZERO=n
# init_on_free zeros pages before returning to allocator —
# stale kernel pointers in freed memory cannot be harvested
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# ── 5. KERNEL POINTER LEAKS ───────────────────────────────────────────────
# Kernel addresses leaked via ANY interface give attackers
# the KASLR base — defeating all address randomization.
# These close every known leak channel:
CONFIG_KPTR_RESTRICT=2
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_PROC_KCORE is not set
# CONFIG_PROC_VMCORE is not set
# Symbolic names in /proc/kallsyms leak ALL kernel addresses
# CONFIG_KALLSYMS is not set
# If kallsyms needed for debugging:
# CONFIG_KALLSYMS_ALL is not set
# BPF JIT spray — JIT-compiled BPF programs placed at known
# addresses defeat KASLR and serve as ROP gadget sources
CONFIG_BPF_JIT_ALWAYS_ON=n
# CONFIG_BPF_UNPRIV_DEFAULT_ON is not set
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_OFF=y
# Unprivileged BPF: the single most abused kernel interface
# of the last decade. Every major kernel exploit since 2016
# uses unprivileged BPF as a primitive.
CONFIG_UNPRIVILEGED_BPF_DISABLED=y

# ── 6. USERCOPY HARDENING ─────────────────────────────────────────────────
# copy_to_user/copy_from_user without bounds = kernel memory
# disclosure or corruption. These enforce strict boundaries:
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_FALLBACK=n
CONFIG_HARDENED_USERCOPY_PAGESPAN=n

# ── 7. INTEGER OVERFLOW ───────────────────────────────────────────────────
# Silent integer wrapping corrupts size calculations silently.
# Decades of heap overflows trace to this single root cause.
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SHIFT=y
CONFIG_UBSAN_DIV_ZERO=y
CONFIG_UBSAN_UNREACHABLE=y
CONFIG_UBSAN_SIGNED_OVERFLOW=y
CONFIG_UBSAN_UNSIGNED_OVERFLOW=y
CONFIG_UBSAN_SANITIZE_ALL=y
# Trap on overflow rather than logging — stops exploit in place
CONFIG_UBSAN_TRAP=y

# ── 8. FORMAT STRING ──────────────────────────────────────────────────────
# Format string vulnerabilities predate the internet.
# Still found in kernel drivers regularly.
CONFIG_FORTIFY_SOURCE=y
# GCC will warn/error on non-literal format strings at compile
# time — catches entire class before it ships

# ── 9. RACE CONDITIONS / CONCURRENCY ─────────────────────────────────────
# TOCTOU and data races are the dominant kernel bug class
# in the last 5 years. These detect them:
CONFIG_KCSAN=n
# KCSAN disabled — too slow for production IPQ8074
# but enable for a test build to audit first:
# CONFIG_KCSAN=y
# CONFIG_KCSAN_REPORT_ONCE_IN_MS=3000
# Lockdep catches lock ordering bugs that lead to
# use-after-free via race condition:
# CONFIG_PROVE_LOCKING is not set  (production — too slow)
# CONFIG_LOCKDEP is not set

# ── 10. FUNCTION POINTER OVERWRITE ───────────────────────────────────────
# Overwriting a function pointer in a kernel struct is the
# standard post-overflow code execution technique.
# CFI enforces that indirect calls only target valid functions:
CONFIG_CFI_CLANG=n
# Requires clang — check your toolchain
# If clang available: CONFIG_CFI_CLANG=y CONFIG_CFI_PERMISSIVE=n
# RETPOLINE for return address protection:
CONFIG_RETPOLINE=y

# ── 11. KERNEL MODULE ATTACKS ─────────────────────────────────────────────
# Unsigned modules are the easiest persistence mechanism.
# Require signature on all modules:
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
# Prevent loading modules after boot finalization:
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# ── 12. DMA ATTACKS ───────────────────────────────────────────────────────
# DMA-capable devices (PCIe, USB) can read/write all RAM
# unless IOMMU enforces boundaries. On IPQ8074:
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_IOMMU_DEFAULT_PASSTHROUGH=n
# Bounce buffers prevent DMA from touching kernel memory:
CONFIG_SWIOTLB=y

# ── 13. NULL POINTER DEREFERENCE ──────────────────────────────────────────
# Mapping page zero allows null pointer dereference exploits.
# mmap_min_addr enforced in kernel prevents this entirely:
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# ── 14. LEGACY BINARY FORMAT LOADERS ─────────────────────────────────────
# a.out, FDPIC, and other legacy formats have poor exploit
# mitigations and are never used on modern systems:
# CONFIG_BINFMT_AOUT is not set
# CONFIG_BINFMT_MISC is not set — unless needed
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ── 15. NETWORK KERNEL ATTACK SURFACE ────────────────────────────────────
# Every unused network protocol is an unaudited attack surface.
# These have generated CVEs for 20+ years and will again:
# CONFIG_PACKET is not set
# CONFIG_UNIX is not set — WARNING: breaks local sockets
# Leave UNIX: CONFIG_UNIX=y
CONFIG_UNIX=y
# CONFIG_NET_9P is not set
# CONFIG_CAIF is not set
# CONFIG_NFC is not set — already eliminated at userspace
# CONFIG_AF_RXRPC is not set
# CONFIG_PHONET is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_WIRELESS is not set  — set this only if wifi handled by firmware
# Netfilter conntrack helpers — every helper is an ALG
# that opens RELATED holes before firewall decides:
# CONFIG_NF_CONNTRACK_H323 is not set
# CONFIG_NF_CONNTRACK_SIP is not set
# CONFIG_NF_CONNTRACK_TFTP is not set
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_CONNTRACK_IRC is not set
# CONFIG_NF_CONNTRACK_AMANDA is not set
CONFIG_NF_CONNTRACK_HELPER=n

# ── 16. PROC/SYSFS INFORMATION DISCLOSURE ────────────────────────────────
# /proc leaks timing, memory layout, file descriptor tables.
# Hide process info between users:
CONFIG_PROC_FS=y
CONFIG_PROC_HIDEPID=2
# hidepid=2: users only see their own processes
# Hides /proc/PID for other users — blocks enumeration

# ── 17. KERNEL SAMEPAGE MERGING ───────────────────────────────────────────
# KSM merges identical memory pages across processes.
# The merge/unmerge timing creates a side channel that
# reveals whether two processes share memory content —
# used in cross-VM attacks and container escapes:
# CONFIG_KSM is not set

# ── 18. USERFAULTFD ───────────────────────────────────────────────────────
# userfaultfd() pauses kernel execution at a page fault
# for arbitrary duration — gives attacker infinite time
# to win races that would otherwise be microseconds wide.
# Has been used in nearly every privilege escalation since 2016:
CONFIG_USERFAULTFD=n

# ── 19. FTRACE / KPROBES ──────────────────────────────────────────────────
# Dynamic kernel patching interfaces — powerful for our
# honeypot but also powerful for rootkit persistence.
# Disable after honeypot deployment:
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# Leave enabled for now — used by CTW honeypot uprobe layer
# Disable before production hardening pass 2:
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y

# ── 20. COVERT CHANNEL: SHARED RESOURCE CONTENTION ───────────────────────
# CPU scheduler, cache partitioning, TLB sharing between
# processes create timing covert channels even with all
# explicit side channels closed. Partial mitigations:
CONFIG_SCHED_CORE=y
# Core scheduling prevents SMT sibling from running
# attacker and victim on the same physical core simultaneously
CONFIG_CPU_ISOLATION=y
# Isolate CPUs from scheduler to reduce contention noise

EOF

echo "Deep hardening config written"

Now resolve and verify:
bash

KSRC=$(find build_dir -name "Makefile" -path "*linux-5.15*" | head -1 | xargs dirname)
cd "$KSRC"
make ARCH=arm64 CROSS_COMPILE=aarch64-openwrt-linux-musl- olddefconfig

# Verify the most critical ones
grep -E "UNPRIVILEGED_BPF|USERFAULTFD|UBSAN_TRAP|INIT_ON_FREE|\
HARDENED_USERCOPY|MODULE_SIG_FORCE|LOCKDOWN|SLAB_FREELIST_HARDENED|\
UNMAP_KERNEL|SHADOW_CALL|PERF_EVENTS|KSM|PROC_HIDEPID|\
NF_CONNTRACK_HELPER|RETPOLINE|FORTIFY" .config | sort

The three that matter most on this list and why almost nobody enables them:

CONFIG_USERFAULTFD=n — this single syscall has been the enabler of nearly every major Linux privilege escalation since 2016. It lets userspace pause kernel execution mid-race indefinitely. Disabling it closes the entire class of race-condition exploits that depend on widening the race window.

CONFIG_UNPRIVILEGED_BPF_DISABLED=y — every significant kernel exploit since 2016 uses unprivileged BPF as a read/write primitive. The JIT turns BPF into executable shellcode at known addresses. This closes the most abused kernel interface of the last decade.

CONFIG_PERF_EVENTS=n — removes the hardware PMU counter interface entirely. LLC cache miss counting via PMU is the measurement primitive for Prime+Probe, Flush+Reload, and every cache timing attack. Without a nanosecond-precision counter, timing attacks become statistically infeasible. Most hardening guides never touch this because it breaks profiling tools — but on a router you do not need profiling.

To run code, enable code execution and file creation in Settings > Capabilities.

