import socket, struct, time

def tftp_send(server_ip, filename, local_file):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(5)

    # WRQ packet
    wrq = b'\x00\x02' + filename.encode() + b'\x00octet\x00'
    sock.sendto(wrq, (server_ip, 69))

    data = open(local_file, 'rb').read()
    block = 1
    offset = 0
    server_port = None

    while offset <= len(data):
        if server_port is None:
            try:
                ack, addr = sock.recvfrom(516)
                server_port = addr[1]
            except:
                print("No response from router — check rescue mode and IP")
                return False

        chunk = data[offset:offset+512]
        pkt = struct.pack('>HH', 3, block) + chunk
        sock.sendto(pkt, (server_ip, server_port))

        try:
            ack, addr = sock.recvfrom(516)
            if struct.unpack('>HH', ack[:4])[1] == block:
                print(f"Block {block} sent ({offset}/{len(data)} bytes)", end='\r')
                block += 1
                offset += 512
        except socket.timeout:
            print(f"Timeout on block {block} — retrying")

    print(f"\nDone — {len(data)} bytes sent")
    return True

tftp_send(
    '192.168.1.1',
    'asus_rt-ax89x-squashfs-factory.bin',
    'bin/targets/ipq807x/generic/openwrt-23.05.6-ipq807x-generic-asus_rt-ax89x-squashfs-factory.bin'
)
EOF

