nft add chain inet dsl_s wan_input_guard '{ type filter hook input priority filter - 5; policy accept; }'
nft add rule inet dsl_s wan_input_guard iifname "wan" ip saddr 0.0.0.0/8 drop
nft add rule inet dsl_s wan_input_guard iifname "wan" ip saddr 10.0.0.0/8 drop
nft add rule inet dsl_s wan_input_guard iifname "wan" ip saddr 127.0.0.0/8 drop
