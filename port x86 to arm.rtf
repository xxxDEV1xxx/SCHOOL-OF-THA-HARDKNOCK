    result=$(nm "$f" 2>/dev/null | grep -l "__Z\|_ZN\|_ZSt" 2>/dev/null)
    if nm "$f" 2>/dev/null | grep -q "__Z\|_ZN\|_ZSt"; then
        echo "C++ symbols in: $f"
        nm "$f" | grep "__Z\|_ZN\|_ZSt" | head -3
    fi
done

That will finger exactly which translation unit has C++ linkage sneaking in so we can fix it at the source.

