# Should say: Squashfs filesystem, little endian...

Correct remaster workflow:
bash

# 1. Mount the squashfs image from CD
mkdir -p /mnt/knoppix
mount -t squashfs /media/cdrom/KNOPPIX/KNOPPIX /mnt/knoppix -o loop,ro

# 2. Copy the entire root filesystem out
mkdir -p /home/remaster/root
cp -ax /mnt/knoppix/. /home/remaster/root/

# 3. Now chroot into that
mount --bind /dev  /home/remaster/root/dev
mount --bind /proc /home/remaster/root/proc
mount --bind /sys  /home/remaster/root/sys
chroot /home/remaster/root /bin/bash

