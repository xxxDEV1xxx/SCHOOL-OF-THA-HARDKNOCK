Good script base. Several issues visible — flags split across lines without continuance, some flags are QEMU version-specific, -kernel-kqemu is deprecated. Here's the corrected full script:
bash

#!/bin/sh
# Author: Christopher Williams
# QEMU boot flags

qemu-system-i386 \
  -fda /home/qemu/floppy.img \
  -hda /home/qemu/maindrive.img \
  -cdrom /home/qemu/FEDORA9.iso \
  -mtdblock /home/qemu/flashmem.img \
  -sd /home/qemu/sdcard.img \
  -pflash /home/qemu/parallelflash.img \
  -boot c \
  -m 256 \
  -smp 1 \
  -k en-us \
  -soundhw ac97 \
  -full-screen \
  -name DEV1 \
  -net none \
  -kernel /home/qemu/kernel2.6.23.img \
  -append "nodhcp noscsi edd=off vga=normal" \
  -initrd /home/qemu/initrd.img \
  -monitor /dev/tty3 \
  -serial /dev/tty2 \
  -parallel /dev/tty4 \
  -pidfile /home/qemu/pidfile.txt \
  -D /home/qemu/qemu.log \
  -hdachs 504,16,63 \
  -L /home/qemu/bios \
  -std-vga \
  -no-acpi \
  -no-reboot \
  -daemonize \
  -option-rom /home/qemu/rom.img

Obtaining each file in /home/qemu/:
bash

mkdir -p /home/qemu
cd /home/qemu

maindrive.img — create blank disk:
bash

qemu-img create -f raw maindrive.img 8G

floppy.img — create blank floppy:
bash

qemu-img create -f raw floppy.img 1474560
mkfs.fat /home/qemu/floppy.img

FEDORA9.iso — extract from your CD:
bash

dd if=/dev/sr0 of=/home/qemu/FEDORA9.iso bs=2048 status=progress

flashmem.img — create blank MTD flash:
bash

qemu-img create -f raw flashmem.img 64M

sdcard.img — create blank SD:
bash

qemu-img create -f raw sdcard.img 512M
mkfs.fat /home/qemu/sdcard.img

parallelflash.img — create blank pflash:
bash

qemu-img create -f raw parallelflash.img 128M

kernel2.6.23.img and initrd.img — pull from Fedora 9 ISO:
bash

# Mount the ISO first
mkdir -p /mnt/f9
mount -t iso9660 /home/qemu/FEDORA9.iso /mnt/f9 -o loop

# Kernel
cp /mnt/f9/isolinux/vmlinuz /home/qemu/kernel2.6.23.img

# initrd
cp /mnt/f9/isolinux/initrd.img /home/qemu/initrd.img

rom.img — use QEMU's built-in BIOS ROMs:
