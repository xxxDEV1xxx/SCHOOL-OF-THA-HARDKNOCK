# Find where QEMU stores its ROMs
find /usr/share/qemu -name "*.rom" | head -10
# Copy pxe or vgabios rom
cp /usr/share/qemu/vgabios-stdvga.bin /home/qemu/rom.img

bios — directory of QEMU BIOS files:
