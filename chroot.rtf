Step 1 — Prepare the floppy image as a bootable block device:
bash

# Create proper 1.44MB floppy
dd if=/dev/zero of=/home/qemu/floppy.img bs=512 count=2880

# Associate with loop device
losetup /dev/loop0 /home/qemu/floppy.img

# Format as FAT12 (standard floppy)
mkfs.msdos -F 12 /dev/loop0

# Mount it
mkdir -p /mnt/floppy
mount /dev/loop0 /mnt/floppy

Step 2 — Install LILO MBR to the floppy:
bash

# Install lilo bootblock to floppy image MBR
lilo -M /dev/loop0 mbr

Step 3 — lilo.conf for the floppy:
bash

cat > /mnt/floppy/lilo.conf << 'EOF'
# LILO bootloader config - CTW DSL/Knoppix floppy
# Author: Christopher Williams

boot=/dev/loop0
map=/mnt/floppy/map
install=mbr
prompt
timeout=50
default=knoppix

# VGA mode - normal text
vga=normal

# Knoppix/DSL entry - kernel on hda, initrd on hdb
image=/home/qemu/kernel2.6.23.img
    label=knoppix
    initrd=/home/qemu/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal lang=us apm=power-off nomce quiet BOOT_IMAGE=knoppix"
    read-only

# Failsafe entry
image=/home/qemu/kernel2.6.23.img
    label=failsafe
    initrd=/home/qemu/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal noapic nolapic noacpi nosmp maxcpus=1 nomce quiet"
    read-only

# DSL toram entry - load full system into RAM
image=/home/qemu/kernel2.6.23.img
    label=toram
    initrd=/home/qemu/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal toram lang=us apm=power-off nomce quiet"
    read-only
EOF

Step 4 — Copy kernel and initrd onto floppy:
bash

# Kernel is too large for floppy directly
# Use floppy only as bootloader, kernel stays on hda
# But we need the map file on the floppy

cp /home/qemu/kernel2.6.23.img /mnt/floppy/vmlinuz
cp /home/qemu/initrd.img /mnt/floppy/initrd.img

If kernel+initrd exceed floppy space (very likely), use this split approach — bootloader only on floppy, kernel on maindrive:
bash

# Place kernel and initrd on maindrive partition 1
mkdir -p /mnt/maindrive
mount -o loop /home/qemu/maindrive.img /mnt/maindrive
cp /home/qemu/kernel2.6.23.img /mnt/maindrive/boot/vmlinuz
cp /home/qemu/initrd.img /mnt/maindrive/boot/initrd.img
umount /mnt/maindrive

# Update lilo.conf to point there
cat > /mnt/floppy/lilo.conf << 'EOF'
boot=/dev/loop0
map=/boot/map
install=mbr
prompt
timeout=50
default=knoppix
vga=normal

image=/boot/vmlinuz
    label=knoppix
    initrd=/boot/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal lang=us apm=power-off nomce quiet BOOT_IMAGE=knoppix"
    read-only

image=/boot/vmlinuz
    label=failsafe
    initrd=/boot/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal noapic nolapic noacpi nosmp maxcpus=1 nomce"
    read-only

image=/boot/vmlinuz
    label=toram
    initrd=/boot/initrd.img
    root=/dev/hda1
    append="nodhcp noscsi edd=off vga=normal toram lang=us apm=power-off nomce quiet"
    read-only
EOF

Step 5 — Run LILO to write the map:
bash

lilo -C /mnt/floppy/lilo.conf -r /mnt/floppy

Step 6 — Clean up loop device:
bash

umount /mnt/floppy
losetup -d /dev/loop0

Step 7 — Update qemuboot1.sh to boot from floppy:
bash

# Change -boot flag
-boot a \
# a = floppy first, falls through to hda for kernel

Key architecture:

    Floppy = LILO MBR + map file + lilo.conf
    /dev/hda = maindrive with /boot/vmlinuz and /boot/initrd.img
    /dev/hda1 = root filesystem with KNOPPIX squashfs
    LILO reads floppy MBR, finds map, loads kernel from hda, hands off to initrd

