    f.write(f"Complainant: Christopher Thomas Williams\n")
    f.write(f"Location: 33.800509, -117.220352\n")
    f.write(f"Address: 267 Momento Ave, Perris CA 92570\n")
    f.write(f"Purpose: FCC complaint evidence — GPS interference logging\n")
    f.write(f"Related filing: FCC Enforcement Bureau — March 31 2026\n")

print(f"Logging started: {timestamp}")
print(f"UBX binary: {ubx_path}")
print(f"NMEA text:  {nmea_path}")
print(f"Metadata:   {meta_path}")
print("Press Ctrl+C to stop.")
print("-" * 50)

ser = serial.Serial(COM_PORT, BAUD, timeout=1)
ubx_file  = open(ubx_path,  'wb')
nmea_file = open(nmea_path, 'w')

bytes_logged = 0
nmea_lines   = 0
start_time   = time.time()

try:
    while True:
        data = ser.read(512)
        if data:
            # Write all raw bytes to UBX binary log
            ubx_file.write(data)
            bytes_logged += len(data)

            # Extract and write NMEA sentences to text log
            try:
                text = data.decode('ascii', errors='ignore')
                for line in text.split('\n'):
                    line = line.strip()
                    if line.startswith('$'):
                        ts = datetime.datetime.utcnow().isoformat()
                        nmea_file.write(f"{ts},{line}\n")
                        nmea_lines += 1
            except Exception:
                pass

            # Flush every write — no data loss on interrupt
            ubx_file.flush()
            nmea_file.flush()

            # Status update every 30 seconds
            elapsed = time.time() - start_time
            if int(elapsed) % 30 == 0 and int(elapsed) > 0:
                print(f"  [{elapsed:.0f}s] {bytes_logged} bytes | {nmea_lines} NMEA lines")

except KeyboardInterrupt:
    end_time = datetime.datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    print(f"\nLogging stopped: {end_time}")
    print(f"Total bytes: {bytes_logged}")
    print(f"NMEA lines:  {nmea_lines}")

    # Append session end to metadata
    with open(meta_path, 'a') as f:
        f.write(f"Session End (UTC): {end_time}\n")
        f.write(f"Total bytes logged: {bytes_logged}\n")
        f.write(f"Total NMEA lines: {nmea_lines}\n")

finally:
    ubx_file.close()
    nmea_file.close()
    ser.close()
    print("Files closed. Session complete.")

