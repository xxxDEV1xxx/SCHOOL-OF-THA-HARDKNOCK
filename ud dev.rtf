import os
import datetime

LOG_DIR = "C:\\GNSS_Evidence\\"
LOCATION_LAT = 33.800509
LOCATION_LON = -117.220352
POSITION_THRESHOLD_M = 100

def nmea_to_decimal(value, direction):
    if not value or len(value) < 4:
        return None
    try:
        if direction in ("N", "S"):
            degrees = float(value[:2])
            minutes = float(value[2:])
        else:
            degrees = float(value[:3])
            minutes = float(value[3:])
        decimal = degrees + minutes / 60.0
        if direction in ("S", "W"):
            decimal = decimal * -1
        return decimal
    except Exception:
        return None

def haversine(lat1, lon1, lat2, lon2):
    import math
    R = 6371000
    phi1 = math.radians(lat1)
    phi2 = math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlam = math.radians(lon2 - lon1)
    a = math.sin(dphi/2)**2 + math.cos(phi1)*math.cos(phi2)*math.sin(dlam/2)**2
    return 2 * R * math.asin(math.sqrt(a))

def parse_gga(fields, timestamp):
    if len(fields) < 10:
        return None
    lat = nmea_to_decimal(fields[2], fields[3])
    lon = nmea_to_decimal(fields[4], fields[5])
    fix_quality = fields[6] if len(fields) > 6 else "0"
    num_sats = fields[7] if len(fields) > 7 else "0"
    hdop = fields[8] if len(fields) > 8 else "0"
    altitude = fields[9] if len(fields) > 9 else "0"
    if lat is None or lon is None:
        return None
    dist = haversine(LOCATION_LAT, LOCATION_LON, lat, lon)
    return {
        "type": "GGA",
        "timestamp": timestamp,
        "lat": lat,
        "lon": lon,
        "fix_quality": fix_quality,
        "num_sats": num_sats,
        "hdop": hdop,
        "altitude": altitude,
        "displacement_m": dist
    }

def parse_gsv(fields, timestamp):
    sats = []
    i = 4
    while i + 3 < len(fields):
        try:
            prn = fields[i]
            elev = fields[i+1]
            azim = fields[i+2]
            snr = fields[i+3].split("*")[0]
            if prn:
                sats.append({
                    "prn": prn,
                    "elevation": elev,
                    "azimuth": azim,
                    "snr": snr
                })
        except Exception:
            pass
        i += 4
    return {"type": "GSV", "timestamp": timestamp, "satellites": sats}

def parse_rmc(fields, timestamp):
    if len(fields) < 8:
        return None
    status = fields[2]
    lat = nmea_to_decimal(fields[3], fields[4])
    lon = nmea_to_decimal(fields[5], fields[6])
    speed_knots = fields[7] if len(fields) > 7 else "0"
    if lat is None or lon is None:
        return None
    dist = haversine(LOCATION_LAT, LOCATION_LON, lat, lon)
    return {
        "type": "RMC",
        "timestamp": timestamp,
        "status": status,
        "lat": lat,
        "lon": lon,
        "speed_knots": speed_knots,
        "displacement_m": dist
    }

# Find most recent NMEA file
nmea_files = [f for f in os.listdir(LOG_DIR) if f.endswith(".nmea")]
if not nmea_files:
    print("No NMEA files found in " + LOG_DIR)
    exit()

nmea_files.sort()
