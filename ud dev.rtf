import serial
import time
import struct

# ============================================================
# CONFIGURATION — SET YOUR COM PORT HERE
# ============================================================
COM_PORT = "COM3"   # <-- change to your actual port
BAUD     = 9600
LOG_PATH = "C:\\GNSS_Evidence\\"
# ============================================================

def checksum(payload):
    ck_a = ck_b = 0
    for byte in payload:
        ck_a = (ck_a + byte) & 0xFF
        ck_b = (ck_b + ck_a) & 0xFF
    return ck_a, ck_b

def build_ubx(cls, msg_id, payload):
    header   = [0xB5, 0x62, cls, msg_id]
    length   = [len(payload) & 0xFF, (len(payload) >> 8) & 0xFF]
    body     = header[2:] + length + list(payload)
    ck_a, ck_b = checksum(body)
    return bytes(header + length + list(payload) + [ck_a, ck_b])

def send_ubx(ser, packet, label):
    ser.write(packet)
    time.sleep(0.25)
    response = ser.read(ser.in_waiting or 10)
    status = "ACK" if b'\x05\x01' in response else \
             "NAK" if b'\x05\x00' in response else "NO_RESP"
    print(f"  {label}: {status} ({packet.hex().upper()})")
    return status

def cfg_msg(cls_id, msg_id, rate_usb=1):
    # UBX-CFG-MSG: set rate per port
    # ports: I2C=0, UART1=1, UART2=2, USB=3, SPI=4
    payload = bytes([cls_id, msg_id, 0, 0, 0, rate_usb, 0, 0])
    return build_ubx(0x06, 0x01, payload)

print("=" * 60)
print("u-blox 7 GLONASS Evidence Logger Configuration")
print(f"Port: {COM_PORT} @ {BAUD} baud")
print("=" * 60)

ser = serial.Serial(COM_PORT, BAUD, timeout=1)
time.sleep(1)
ser.reset_input_buffer()

# ============================================================
# STEP 1: ENABLE GLONASS — UBX-CFG-GNSS
# GPS:     8 min, 14 max, sigCfgMask=0x01
# SBAS:    1 min,  3 max, sigCfgMask=0x01
# GLONASS: 4 min, 14 max, sigCfgMask=0x01
# Total max = 14+14+3 = 31 (under 32 channel ceiling)
# ============================================================
print("\n[1] Configuring GNSS constellations (GPS + GLONASS + SBAS)...")

gnss_payload = bytes([
    0x00,       # msgVer
    0x00,       # numTrkChHw (read-only, set 0)
    0x20,       # numTrkChUse = 32 total channels
    0x03,       # numConfigBlocks = 3 (GPS, SBAS, GLONASS)
    # --- GPS ---
    0x00,       # gnssId = 0 (GPS)
    0x08,       # resTrkCh = 8 min channels
    0x0E,       # maxTrkCh = 14 max channels
    0x00,       # reserved
    0x01, 0x00, 0x01, 0x01,  # flags: enable=1, sigCfgMask=L1C/A
    # --- SBAS ---
    0x01,       # gnssId = 1 (SBAS)
    0x01,       # resTrkCh = 1
    0x03,       # maxTrkCh = 3
    0x00,       # reserved
    0x01, 0x00, 0x01, 0x01,  # flags: enable=1
    # --- GLONASS ---
    0x06,       # gnssId = 6 (GLONASS)
    0x04,       # resTrkCh = 4 min channels
    0x0E,       # maxTrkCh = 14 max channels
    0x00,       # reserved
    0x01, 0x00, 0x01, 0x01,  # flags: enable=1, sigCfgMask=L1OF
])

pkt = build_ubx(0x06, 0x3E, gnss_payload)
send_ubx(ser, pkt, "CFG-GNSS GPS+SBAS+GLONASS")
time.sleep(0.5)

# ============================================================
# STEP 2: ENABLE JAMMING/SPOOFING DETECTION — UBX-CFG-ITFM
# Broadband threshold: 3, CW threshold: 15
# ============================================================
print("\n[2] Enabling jamming/spoofing detection (CFG-ITFM)...")

itfm_payload = struct.pack('<II',
    0x0000AC03 | (1 << 31),  # config: enable bit + thresholds
    0x00000047               # config2: CW threshold=15, antSetting=unknown
)
pkt = build_ubx(0x06, 0x39, itfm_payload)
send_ubx(ser, pkt, "CFG-ITFM jamming detection")

# ============================================================
# STEP 3: ENABLE EVIDENCE MESSAGES ON USB (port 3, rate 1)
# ============================================================
print("\n[3] Enabling evidence message outputs on USB port...")

messages = [
    (0x02, 0x10, "RXM-RAW   — pseudorange+carrier phase per SV"),
    (0x02, 0x13, "RXM-SFRBX — raw subframe (ephemeris integrity)"),
    (0x01, 0x03, "NAV-STATUS — fix status + spoofing flags"),
    (0x01, 0x04, "NAV-DOP   — dilution of precision"),
    (0x01, 0x07, "NAV-PVT   — position/velocity/time solution"),
    (0x01, 0x22, "NAV-CLOCK — GPS/GLONASS clock bias (timing attack indicator)"),
    (0x01, 0x30, "NAV-SVINFO — satellite info all constellations"),
    (0x01, 0x35, "NAV-SAT   — satellite status + signal quality"),
    (0x0A, 0x09, "MON-HW    — jamInd + noise floor + AGC"),
    (0x0A, 0x21, "MON-HW2   — extended hardware monitor"),
]

for cls_id, msg_id, label in messages:
    pkt = cfg_msg(cls_id, msg_id, rate_usb=1)
    send_ubx(ser, pkt, label)
    time.sleep(0.1)

# ============================================================
# STEP 4: ENABLE NMEA SENTENCES ON USB
# ============================================================
print("\n[4] Enabling NMEA sentences on USB port...")

nmea_messages = [
    (0xF0, 0x00, "NMEA-GGA  — position fix"),
    (0xF0, 0x02, "NMEA-GSA  — DOP and active satellites"),
    (0xF0, 0x03, "NMEA-GSV  — satellites in view all constellations"),
    (0xF0, 0x04, "NMEA-RMC  — recommended minimum data"),
    (0xF0, 0x05, "NMEA-VTG  — course over ground"),
    (0xF0, 0x01, "NMEA-GLL  — lat/lon"),
]

for cls_id, msg_id, label in nmea_messages:
    pkt = cfg_msg(cls_id, msg_id, rate_usb=1)
    send_ubx(ser, pkt, label)
    time.sleep(0.1)

# ============================================================
# STEP 5: SET UPDATE RATE TO 1Hz — UBX-CFG-RATE
# ============================================================
print("\n[5] Setting measurement rate to 1Hz...")

rate_payload = struct.pack('<HHH',
    1000,   # measRate = 1000ms = 1Hz
    1,      # navRate = 1 nav solution per measurement
    1       # timeRef = 1 (GPS time)
)
pkt = build_ubx(0x06, 0x08, rate_payload)
send_ubx(ser, pkt, "CFG-RATE 1Hz")

# ============================================================
# STEP 6: SAVE ALL CONFIG TO FLASH — UBX-CFG-CFG
# ============================================================
print("\n[6] Saving configuration to flash (persistent)...")

save_payload = struct.pack('<III',
    0x00000000,   # clearMask: clear nothing
    0xFFFFFFFF,   # saveMask: save everything
    0x00000017    # deviceMask: BBR + Flash + EEPROM + SPI Flash
)
pkt = build_ubx(0x06, 0x09, save_payload)
send_ubx(ser, pkt, "CFG-CFG save to flash")
time.sleep(1)

# ============================================================
# STEP 7: VERIFY GLONASS IS NOW ACTIVE
# ============================================================
print("\n[7] Polling CFG-GNSS to verify GLONASS enabled...")

poll_pkt = build_ubx(0x06, 0x3E, b'')
ser.write(poll_pkt)
time.sleep(0.5)
response = ser.read(ser.in_waiting or 100)
if b'\x06\x3E' in response:
    print("  CFG-GNSS response received — check u-center for GLONASS status")
    glonass_active = response.hex().find('060001') > 0
    print(f"  Raw response: {response.hex().upper()}")
else:
    print("  No CFG-GNSS poll response — check connection")

ser.close()

print("\n" + "=" * 60)
print("Configuration complete.")
print("Next step: run logging script to capture evidence.")
print("=" * 60)

