def score_hypothesis(event):
    """
    Returns (prob_radiation, prob_emp) summing to 100.
    Each parameter contributes to shifting the balance.
    """
    score_A = 50  # start at 50/50
    score_B = 50

    reasons = []

    # Parameter 1: Waveform flatness
    # Coefficient of variation (CV) = std/mean of count rate during event
    # Low CV = flat plateau = anti-Poisson = shift toward B
    cv = event.get("count_rate_cv")
    if cv is not None:
        if cv < 0.05:    # extremely flat
            score_A -= 20; score_B += 20
            reasons.append(f"CV={cv:.3f} — extremely flat plateau, "
                           f"P(Poisson)<<0.001, shift +20 toward EMI")
        elif cv < 0.10:
            score_A -= 10; score_B += 10
            reasons.append(f"CV={cv:.3f} — flat plateau, shift +10 toward EMI")
        else:
            score_A += 5; score_B -= 5
            reasons.append(f"CV={cv:.3f} — normal variance, slight shift toward radiation")

    # Parameter 2: Onset sharpness
    # Rise time in seconds from baseline to peak
    rise_time = event.get("rise_time_sec")
    if rise_time is not None:
        if rise_time < 1.0:
            score_A -= 20; score_B += 20
            reasons.append(f"Rise time={rise_time:.2f}s — sub-second onset, "
                           "physically impossible for mobile radiation source, "
                           "shift +20 toward EMI")
        elif rise_time < 5.0:
            score_A -= 10; score_B += 10
            reasons.append(f"Rise time={rise_time:.2f}s — rapid onset, shift +10 toward EMI")
        else:
            score_A += 5; score_B -= 5
            reasons.append(f"Rise time={rise_time:.2f}s — gradual onset, "
                           "consistent with source approach")

    # Parameter 3: RF correlation
    rf_concurrent = event.get("rf_anomaly_concurrent", False)
    rf_types = event.get("rf_anomaly_types", [])
    if rf_concurrent:
        n_types = len(rf_types)
        # Each concurrent independent RF anomaly type multiplies improbability
        shift = min(25, n_types * 8)
        score_A -= shift; score_B += shift
        reasons.append(f"Concurrent RF anomalies: {rf_types} — "
                       f"P(independent coincidence) < 10^-{n_types*2}, "
                       f"shift +{shift} toward EMI")

    # Parameter 4: Dead time ceiling check
    max_cps = 1 / 190e-6  # ~5263 CPS
    peak_cps = event.get("peak_cps")
    if peak_cps is not None:
        if peak_cps > max_cps:
            score_A = max(score_A - 35, 5)
            score_B = min(score_B + 35, 95)
            reasons.append(f"Peak CPS={peak_cps:.0f} exceeds J305 dead time "
                           f"ceiling ({max_cps:.0f} CPS) — counts cannot be "
                           "real radiation, shift +35 toward EMI")
        elif peak_cps > max_cps * 0.5:
            score_A -= 10; score_B += 10
            reasons.append(f"Peak CPS={peak_cps:.0f} approaching dead time "
                           "ceiling, shift +10 toward EMI")

    # Parameter 5: Termination sharpness
    fall_time = event.get("fall_time_sec")
    if fall_time is not None:
        if fall_time < 1.0:
            score_A -= 15; score_B += 15
            reasons.append(f"Fall time={fall_time:.2f}s — sub-second termination, "
                           "consistent with electronic switch-off, "
                           "shift +15 toward EMI")
        elif fall_time < 5.0:
            score_A -= 8; score_B += 8

    # Parameter 6: Magnitude implausibility
    # 293x baseline = what dose rate would that imply?
    # Normal background ~0.10 µSv/hr
    # 293x = ~29.3 µSv/hr = dangerous but not lethal
    # However if it were real, it would be detectable by neighbors,
    # trigger NRC automatic monitoring, etc.
    multiplier = event.get("baseline_multiplier")
    if multiplier is not None:
        if multiplier > 100:
            score_A -= 10; score_B += 10
            reasons.append(f"{multiplier}x baseline — would require source "
                           "activity detectable by NRC monitoring network, "
                           "no NRC alert issued, shift +10 toward EMI")

    # Normalize to 100
    total = score_A + score_B
    prob_A = round((score_A / total) * 100, 1)
    prob_B = round((score_B / total) * 100, 1)

    return prob_A, prob_B, reasons

